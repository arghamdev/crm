{
  "Authentication": {
    "Mode": "Demo",
    "DemoPassword": "Demo@1405",
    "Lockout": {
      "MaxFailures": 5,
      "WindowMinutes": 15,
      "LockoutMinutes": 15
    },
    "Session": {
      "IdleMinutes": 30,
      "AbsoluteHours": 8,
      "MaxConcurrent": 3
    },
    "Oidc": {
      "Authority": "https://login.example.test/tenant/v2.0",
      "ClientId": "replace-from-secret-store",
      "ClientSecret": "replace-from-secret-store",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc"
    }
  },
  "DataProtection": {
    "KeyRingPath": "",
    "RequireSharedKeyRing": false
  },
  "Persistence": {
    "Mode": "InMemory",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "Cache": {
    "Mode": "Memory",
    "InstanceName": "EnterpriseCrm:"
  },
  "ConnectionStrings": {
    "CrmDatabase": "",
    "Redis": ""
  },
  "Security": {
    "IpHashSalt": "demo-only-replace-from-secret-store"
  },
  "Service": {
    "Escalation": {
      "Enabled": true,
      "IntervalMinutes": 5
    }
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
