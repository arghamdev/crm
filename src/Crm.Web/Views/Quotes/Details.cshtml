@model QuoteDetailsDto
@using Crm.Domain.Commercial
@{ ViewData["Title"] = $"پیشنهاد {Model.Quote.Code}"; }
<header class="page-header"><div><span class="eyebrow">Quote Governance</span><h1>@Model.Quote.Code <small>نسخه @Model.Quote.Revision</small></h1><p>@Model.Quote.Customer — @Model.Quote.Opportunity</p></div><div class="page-actions">@if(Model.CanEdit){<a class="button button--primary" href="/quotes/@Model.Quote.Id/lines/create" hx-get="/quotes/@Model.Quote.Id/lines/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg> افزودن ردیف</a>}<a class="button button--ghost" href="/quotes">بازگشت</a></div></header>
<section class="quote-stats"><div><p><small>مبلغ ناخالص</small><strong>@($"{Model.Quote.GrossAmount:N0}")</strong></p></div><div><p><small>تخفیف / خالص</small><strong>@($"{Model.Quote.DiscountPercent:N2}٪ / {Model.Quote.NetAmount:N0}")</strong></p></div><div><p><small>Margin محاسبه‌شده</small><strong>@(Model.Quote.MarginMasked ? "محرمانه" : $"{Model.Quote.MarginPercent:N2}٪")</strong></p></div></section>
<section class="panel table-panel"><div class="panel-heading"><div><strong>ردیف‌های پیشنهاد</strong><small>قیمت و Cost در زمان افزودن Snapshot شده‌اند</small></div></div><div class="table-wrap"><table><thead><tr><th>کالا</th><th>مقدار</th><th>قیمت پایه</th><th>تخفیف</th><th>خالص</th><th>Margin</th><th></th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td><strong>@line.ProductName</strong><small class="cell-sub">@line.ProductCode · @line.PriceSource</small></td><td>@line.Quantity @line.Unit</td><td>@($"{line.ListUnitPrice:N0}")</td><td>@line.DiscountPercent٪</td><td>@($"{line.NetAmount:N0}")</td><td>@(line.MarginMasked ? "—" : $"{line.MarginPercent}٪")</td><td>@if(Model.CanEdit){<form method="post" action="/quotes/@Model.Quote.Id/lines/@line.Id/remove">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Model.Quote.Version"/><button class="link-button link-button--danger" type="submit">حذف</button></form>}</td></tr>}</tbody></table></div></section>
<section class="quote-governance-grid"><article class="panel"><div class="panel-heading"><div><strong>عملیات و کنترل</strong><small>وضعیت: @Model.Quote.Status · سطح: @Model.Quote.ApprovalLevel</small></div></div><div class="form-stack">
@if(Model.CanSubmit){<form method="post" action="/quotes/@Model.Quote.Id/submit">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Quote.Version"/><input type="hidden" name="Reason" value="ارسال برای کنترل تجاری"/><button class="button button--primary" type="submit">ارسال برای تأیید</button></form>}
@if(Model.CanApprove){<form method="post" action="/quotes/@Model.Quote.Id/decision">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Quote.Version"/><label class="field"><span>توضیح تصمیم *</span><input name="Comment" required /></label><div class="row-actions"><button class="button button--soft-green" name="Decision" value="Approved" type="submit">تأیید مرحله</button><button class="button button--soft-danger" name="Decision" value="Rejected" type="submit">رد پیشنهاد</button></div></form>}
@if(Model.CanSend){<form method="post" action="/quotes/@Model.Quote.Id/send">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Model.Quote.Version"/><button class="button button--primary" type="submit">ثبت ارسال به مشتری</button></form>}
@if(Model.CanRecordOutcome){<form method="post" action="/quotes/@Model.Quote.Id/outcome">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Quote.Version"/><input type="hidden" name="Reason" value="نتیجه اعلام مشتری"/><div class="row-actions"><button class="button button--soft-green" name="Accepted" value="true" type="submit">پذیرفته شد</button>@if(Model.Quote.ValidUntilUtc <= DateTimeOffset.UtcNow){<button class="button button--soft-danger" name="Accepted" value="false" type="submit">منقضی شد</button>}</div></form>}
@if(Model.CanRevise){<form method="post" action="/quotes/@Model.Quote.Id/revise">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Quote.Version"/><input type="hidden" name="Reason" value="ساخت نسخه بازنگری‌شده"/><label class="field"><span>اعتبار نسخه جدید</span><input name="ValidUntilUtc" type="datetime-local" value="@DateTimeOffset.UtcNow.AddDays(30).ToString("yyyy-MM-ddTHH:mm")"/></label><button class="button button--ghost" type="submit">ساخت نسخه جدید</button></form>}
</div></article><article class="panel"><div class="panel-heading"><div><strong>مسیر تأیید</strong><small>نقش‌های باقیمانده</small></div></div>@if(Model.PendingRoles.Count==0){<p class="muted">مرحله تأیید بازی باقی نمانده است.</p>}else{<ul class="timeline-list">@foreach(var role in Model.PendingRoles){<li><strong>@role</strong><small>در انتظار تصمیم مجاز</small></li>}</ul>}@foreach(var decision in Model.Decisions){<div class="timeline-item"><div><strong>@decision.Role — @decision.Decision</strong><p>@decision.Comment</p><small>@decision.DecidedBy · @decision.DecidedAtUtc.ToString("yyyy/MM/dd HH:mm")</small></div></div>}</article></section>
<section class="panel"><div class="panel-heading"><div><strong>تاریخچه وضعیت</strong><small>Audit غیرقابل ویرایش</small></div></div>@foreach(var item in Model.History){<div class="timeline-item"><div><strong>@item.FromStatus → @item.ToStatus</strong><p>@item.Reason</p><small>@item.ChangedBy · @item.ChangedAtUtc.ToString("yyyy/MM/dd HH:mm")</small></div></div>}</section>
