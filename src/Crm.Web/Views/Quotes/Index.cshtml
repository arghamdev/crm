@model QuoteWorkspaceDto
@{ ViewData["Title"] = "پیشنهادهای قیمت"; }
<header class="page-header"><div><span class="eyebrow">Commercial Control</span><h1>پیشنهادهای قیمت</h1><p>Line Item، Snapshot قیمت ERP، نسخه‌بندی و گردش تأیید تخفیف</p></div><div class="page-actions"><a class="button button--primary" href="/quotes/create" hx-get="/quotes/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg> پیشنهاد جدید</a></div></header>
<section class="quote-stats"><div><span class="mini-icon"><svg><use href="#i-file"/></svg></span><p><small>ارزش باز خالص</small><strong>@($"{Model.OpenNetAmount:N0}")</strong></p></div><div><span class="mini-icon mini-icon--amber"><svg><use href="#i-clock"/></svg></span><p><small>در انتظار تأیید</small><strong>@Model.PendingApprovalCount</strong></p></div><div><span class="mini-icon mini-icon--green"><svg><use href="#i-check"/></svg></span><p><small>پیش‌نویس / نزدیک انقضا</small><strong>@Model.DraftCount / @Model.ExpiringCount</strong></p></div></section>
<section class="panel table-panel"><div class="toolbar"><strong>فهرست پیشنهادها</strong><span class="muted">حداکثر تخفیف ۲۰٪؛ حداقل Margin محاسبه‌شده ۱۵٪</span></div><div id="quoteTable" hx-get="/quotes/table" hx-trigger="quoteChanged from:body"><partial name="_Table" model="Model" /></div></section>
