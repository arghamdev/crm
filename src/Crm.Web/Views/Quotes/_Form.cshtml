@model CreateQuoteDraftCommand
@{ var branches = ViewBag.Branches as IReadOnlyList<OrganizationUnitOptionDto> ?? Array.Empty<OrganizationUnitOptionDto>(); var customers = ViewBag.Customers as IReadOnlyList<CustomerDto> ?? Array.Empty<CustomerDto>(); var opportunities = ViewBag.Opportunities as IReadOnlyList<OpportunityDto> ?? Array.Empty<OpportunityDto>(); var products = ViewBag.Products as IReadOnlyList<ProductPriceDto> ?? Array.Empty<ProductPriceDto>(); }
<form class="drawer-form" method="post" action="/quotes/create" hx-post="/quotes/create" hx-target="#drawerBody" hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>مشخصات پیشنهاد</h3><div class="form-grid"><label class="field"><span>مشتری *</span><select asp-for="CustomerId" required hx-get="/quotes/opportunity-options" hx-trigger="change" hx-target="#opportunitySelect" hx-swap="innerHTML" hx-include="this"><option value="">انتخاب کنید</option>@foreach (var customer in customers) { <option value="@customer.Id">@customer.Name — @customer.Code</option> }</select><span asp-validation-for="CustomerId" class="field-error"></span></label><label class="field"><span>فرصت *</span><select asp-for="OpportunityId" id="opportunitySelect" required><partial name="_OpportunityOptions" model="opportunities" /></select><span asp-validation-for="OpportunityId" class="field-error"></span></label><label class="field"><span>شعبه *</span><select asp-for="BranchId">@foreach (var branch in branches) { <option value="@branch.Id">@branch.Name — @branch.Code</option> }</select></label><label class="field"><span>اعتبار تا *</span><input asp-for="ValidUntilUtc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></label><label class="field"><span>ارز</span><select asp-for="CurrencyCode"><option value="IRR">ریال ایران (IRR)</option></select></label><label class="field field--full"><span>شرایط پرداخت *</span><input asp-for="PaymentTerms" /></label></div></section><section class="form-section"><h3>ردیف اولیه از ERP Mock</h3><div class="form-grid"><label class="field field--full"><span>کالا / خدمت *</span><select asp-for="ProductCode">@foreach (var product in products) { <option value="@product.Code">@product.Code — @product.Name — @($"{product.ListUnitPrice:N0}")</option> }</select></label><label class="field"><span>مقدار *</span><input asp-for="Quantity" type="number" min="0.001" step="0.001" /></label><label class="field"><span>تخفیف ردیف</span><input asp-for="DiscountPercent" type="number" min="0" max="20" step="0.1" /></label></div><div class="quote-calc"><span>قاعده نمونه</span><strong>قیمت و Cost قابل ورود دستی نیست</strong><small>Margin از Snapshot قیمت و بهای تمام‌شده محاسبه می‌شود.</small></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ساخت پیش‌نویس</button></div>
</form>
