@model QuoteWorkspaceDto
@functions {
    private static string StatusText(QuoteStatus value) => value switch { QuoteStatus.Draft => "پیش‌نویس", QuoteStatus.Submitted => "ارسال‌شده برای کنترل", QuoteStatus.PendingApproval => "در انتظار تأیید", QuoteStatus.Approved => "تأییدشده", QuoteStatus.Rejected => "ردشده", QuoteStatus.Sent => "ارسال به مشتری", QuoteStatus.Accepted => "پذیرفته‌شده", QuoteStatus.Expired => "منقضی", _ => value.ToString() };
    private static string StatusClass(QuoteStatus value) => value switch { QuoteStatus.Approved => "badge--success", QuoteStatus.PendingApproval => "badge--warning", QuoteStatus.Rejected => "badge--danger", _ => "badge--neutral" };
}
<div class="table-wrap"><table><thead><tr><th>کد / نسخه</th><th>مشتری / فرصت</th><th>مبلغ خالص</th><th>تخفیف</th><th>Margin</th><th>اعتبار</th><th>وضعیت</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Items)
{
    <tr><td><code class="code-strong">@item.Code</code><small class="cell-sub">نسخه @item.Revision</small></td><td><strong>@item.Customer</strong><small class="cell-sub">@item.Opportunity</small></td><td>@($"{item.NetAmount:N0} {item.CurrencyCode}")</td><td><span class="discount @(item.DiscountPercent > 10 ? "is-high" : "")">@item.DiscountPercent٪</span></td><td>@(item.MarginMasked ? "—" : $"{item.MarginPercent}٪")</td><td>@item.ValidUntilUtc.ToString("yyyy/MM/dd")</td><td><span class="badge @StatusClass(item.Status)"><span></span>@StatusText(item.Status)</span></td><td><a class="link-button" href="/quotes/@item.Id">مشاهده</a></td></tr>
}
</tbody></table></div><div class="table-footer"><span>@Model.TotalCount پیشنهاد · صفحه @Model.Page از @Model.TotalPages</span><nav class="pagination">@if (Model.Page > 1) { <a class="link-button" href="/quotes?page=@(Model.Page - 1)" hx-get="/quotes/table?page=@(Model.Page - 1)" hx-target="#quoteTable">قبلی</a> }@if (Model.Page < Model.TotalPages) { <a class="link-button" href="/quotes?page=@(Model.Page + 1)" hx-get="/quotes/table?page=@(Model.Page + 1)" hx-target="#quoteTable">بعدی</a> }</nav></div>
