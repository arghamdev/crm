@model DealerDetailsDto
@{
    ViewData["Title"] = $"نماینده {Model.Dealer.TradeName}";
    string DealerStatusLabel(DealerStatus value) => value switch { DealerStatus.Draft => "پیش‌نویس", DealerStatus.PendingApproval => "در انتظار تأیید", DealerStatus.Active => "فعال", DealerStatus.Suspended => "تعلیق", DealerStatus.Terminated => "خاتمه‌یافته", _ => value.ToString() };
    string ContractStatusLabel(DealerContractStatus value) => value switch { DealerContractStatus.Draft => "پیش‌نویس", DealerContractStatus.PendingApproval => "در انتظار تأیید", DealerContractStatus.Active => "فعال", DealerContractStatus.Expired => "منقضی", DealerContractStatus.Terminated => "خاتمه‌یافته", _ => value.ToString() };
    string TerritoryStatusLabel(DealerTerritoryStatus value) => value switch { DealerTerritoryStatus.Proposed => "پیشنهادی", DealerTerritoryStatus.Active => "فعال", DealerTerritoryStatus.Ended => "پایان‌یافته", _ => value.ToString() };
}
<header class="page-header">
    <div><a class="back-link" href="/dealers">بازگشت به نمایندگان</a><span class="eyebrow">@Model.Dealer.Code · @Model.Dealer.DealerId</span><h1>@Model.Dealer.TradeName</h1><p>@Model.Dealer.LegalName · @Model.Dealer.City · مدیر کانال: @Model.ChannelManager</p></div>
    <div class="page-actions">
        @if(Model.CanEdit){<button class="button button--ghost" type="button" hx-get="/dealers/@Model.Dealer.Id/edit" hx-target="#drawerBody" hx-swap="innerHTML" data-open-drawer="true">ویرایش پرونده</button>}
        @if(Model.CanRequestContract){<button class="button button--ghost" type="button" hx-get="/dealers/@Model.Dealer.Id/contracts/create" hx-target="#drawerBody" hx-swap="innerHTML" data-open-drawer="true">قرارداد جدید</button>}
        @if(Model.CanRequestTerritory){<button class="button button--ghost" type="button" hx-get="/dealers/@Model.Dealer.Id/territories/create" hx-target="#drawerBody" hx-swap="innerHTML" data-open-drawer="true">درخواست Territory</button>}
        @if(Model.CanAssignCustomer){<button class="button button--ghost" type="button" hx-get="/dealers/@Model.Dealer.Id/customers/assign" hx-target="#drawerBody" hx-swap="innerHTML" data-open-drawer="true">تخصیص مشتری</button>}
        @if(Model.CanSetTarget){<button class="button button--primary" type="button" hx-get="/dealers/@Model.Dealer.Id/target" hx-target="#drawerBody" hx-swap="innerHTML" data-open-drawer="true">ثبت هدف</button>}
    </div>
</header>

<section class="dealer-hero">
    <article><span>وضعیت</span><strong>@DealerStatusLabel(Model.Dealer.Status)</strong><small>@(Model.StatusReason ?? "بدون توضیح")</small></article>
    <article><span>Territory اصلی</span><strong>@Model.Dealer.TerritoryName</strong><small>@Model.Dealer.BranchId · @Model.Dealer.ActiveTerritories تخصیص فعال</small></article>
    <article><span>تحقق هدف</span><strong>@($"{Model.Dealer.AchievementPercent:N1}")٪</strong><small>@($"{Model.Dealer.NetSales:N0}") از @($"{Model.Dealer.TargetAmount:N0}") ریال</small></article>
    <article><span>سبد مشتری</span><strong>@Model.Dealer.CustomerCount</strong><small>@Model.Dealer.ActiveContracts قرارداد فعال</small></article>
</section>

@if(Model.CanSubmit || Model.CanApprove || Model.CanSuspend || Model.CanTerminate){
<section class="panel dealer-actions"><div class="panel-heading"><div><strong>گردش وضعیت نماینده</strong><small>هر انتقال با ExpectedVersion، دلیل و Audit ثبت می‌شود</small></div></div><div class="action-grid">
    @if(Model.CanSubmit){<form method="post" action="/dealers/@Model.Dealer.Id/status" hx-post="/dealers/@Model.Dealer.Id/status"><input type="hidden" name="TargetStatus" value="PendingApproval"/><input type="hidden" name="ExpectedVersion" value="@Model.Dealer.Version"/><input name="Reason" value="قرارداد و Territory تکمیل شد" aria-label="دلیل ارسال"/>@Html.AntiForgeryToken()<button class="button button--primary" type="submit">ارسال برای تأیید</button></form>}
    @if(Model.CanApprove){<form method="post" action="/dealers/@Model.Dealer.Id/status" hx-post="/dealers/@Model.Dealer.Id/status"><input type="hidden" name="TargetStatus" value="Active"/><input type="hidden" name="ExpectedVersion" value="@Model.Dealer.Version"/><input name="Reason" value="تأیید نهایی مدیر کانال" aria-label="دلیل تأیید"/>@Html.AntiForgeryToken()<button class="button button--primary" type="submit">فعال‌سازی</button></form>}
    @if(Model.CanSuspend){<form method="post" action="/dealers/@Model.Dealer.Id/status" hx-post="/dealers/@Model.Dealer.Id/status"><input type="hidden" name="TargetStatus" value="Suspended"/><input type="hidden" name="ExpectedVersion" value="@Model.Dealer.Version"/><input name="Reason" placeholder="دلیل تعلیق" aria-label="دلیل تعلیق" required/>@Html.AntiForgeryToken()<button class="button button--danger" type="submit">تعلیق</button></form>}
    @if(Model.CanTerminate){<form method="post" action="/dealers/@Model.Dealer.Id/status" hx-post="/dealers/@Model.Dealer.Id/status"><input type="hidden" name="TargetStatus" value="Terminated"/><input type="hidden" name="ExpectedVersion" value="@Model.Dealer.Version"/><input name="Reason" placeholder="دلیل خاتمه" aria-label="دلیل خاتمه" required/>@Html.AntiForgeryToken()<button class="button button--ghost" type="submit">خاتمه همکاری</button></form>}
</div></section>}

<section class="customer-360-grid">
    <article class="panel"><div class="panel-heading"><div><strong>اعتبار و مانده نماینده</strong><small>Projection فقط‌خواندنی از Accounting</small></div>@if(Model.CanSyncFinancial){<form method="post" action="/dealers/@Model.Dealer.Id/financial-sync" hx-post="/dealers/@Model.Dealer.Id/financial-sync"><input type="hidden" name="expectedVersion" value="@Model.Dealer.Version"/>@Html.AntiForgeryToken()<button class="button button--ghost" type="submit">همگام‌سازی</button></form>}</div>
        @if(Model.Financial is null){<div class="empty-state"><strong>اطلاعات مالی قابل نمایش نیست.</strong><small>Projection موجود نیست یا کاربر مجوز مشاهده ندارد.</small></div>}
        else {<div class="finance-grid"><span><small>سقف اعتبار</small><b>@($"{Model.Financial.CreditLimit:N0}")</b></span><span><small>اعتبار مصرف‌شده</small><b>@($"{Model.Financial.CreditUsed:N0}")</b></span><span><small>اعتبار آزاد</small><b>@($"{Model.Financial.AvailableCredit:N0}")</b></span><span><small>مانده</small><b>@($"{Model.Financial.Balance:N0}")</b></span><span class="is-danger"><small>سررسیدشده</small><b>@($"{Model.Financial.OverdueAmount:N0}")</b></span></div><p class="source-note">@Model.Financial.Source · @Model.Financial.SynchronizedAtUtc.ToString("yyyy/MM/dd HH:mm") · @Model.Financial.FreshnessStatus</p>}
    </article>
    <article class="panel"><div class="panel-heading"><div><strong>هدف و عملکرد</strong><small>هدف CRM-owned؛ فروش ERP/BI-owned</small></div>@if(Model.CanSyncPerformance){<form method="post" action="/dealers/@Model.Dealer.Id/performance-sync" hx-post="/dealers/@Model.Dealer.Id/performance-sync"><input type="hidden" name="expectedVersion" value="@Model.Dealer.Version"/>@Html.AntiForgeryToken()<button class="button button--ghost" type="submit">همگام‌سازی</button></form>}</div>
        @if(Model.Performance is null){<div class="empty-state"><strong>Snapshot عملکرد موجود نیست.</strong><small>همگام‌سازی عملکرد را اجرا کنید.</small></div>}
        else {<div class="performance-progress"><span><strong>@($"{Model.Performance.AchievementPercent:N1}")٪</strong><small>@Model.Performance.OrderCount سفارش</small></span><progress max="100" value="@Math.Min(Model.Performance.AchievementPercent,100)" aria-label="درصد تحقق هدف"></progress></div><div class="finance-grid"><span><small>هدف دوره</small><b>@($"{Model.Performance.TargetAmount:N0}")</b></span><span><small>فروش خالص</small><b>@($"{Model.Performance.NetSales:N0}")</b></span></div><p class="source-note">@Model.Performance.Source · @Model.Performance.FreshnessStatus</p>}
    </article>
</section>

<section class="panel"><div class="panel-heading"><div><strong>قراردادها</strong><small>تفکیک وظیفه درخواست و تأیید</small></div></div><div class="record-list">
@if(Model.Contracts.Count == 0){<p class="empty-inline">قراردادی ثبت نشده است.</p>}
@foreach(var item in Model.Contracts){<div><span><strong>@item.ContractNumber · @ContractStatusLabel(item.Status)</strong><small>@item.ValidFromUtc.ToString("yyyy/MM/dd") تا @item.ValidToUtc.ToString("yyyy/MM/dd") · هدف @($"{item.AnnualTarget:N0}") · درخواست: @item.RequestedBy</small></span><div class="inline-actions">@if(item.Status == DealerContractStatus.Draft && Model.CanRequestContract){<form method="post" action="/dealers/@Model.Dealer.Id/contracts/@item.Id/submit" hx-post="/dealers/@Model.Dealer.Id/contracts/@item.Id/submit"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="ارسال قرارداد برای تأیید"/>@Html.AntiForgeryToken()<button class="link-button" type="submit">ارسال</button></form>}@if(item.Status == DealerContractStatus.PendingApproval && Model.CanApproveContract && item.RequestedByUserId != User.CrmUserId()){<form method="post" action="/dealers/@Model.Dealer.Id/contracts/@item.Id/approve" hx-post="/dealers/@Model.Dealer.Id/contracts/@item.Id/approve"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="کنترل قرارداد و تضامین انجام شد"/>@Html.AntiForgeryToken()<button class="link-button" type="submit">تأیید</button></form>}@if(item.Status == DealerContractStatus.Active && Model.CanApproveContract && (Model.Dealer.Status != DealerStatus.Active || Model.Contracts.Count(x => x.Status == DealerContractStatus.Active) > 1)){<form method="post" action="/dealers/@Model.Dealer.Id/contracts/@item.Id/end" hx-post="/dealers/@Model.Dealer.Id/contracts/@item.Id/end" data-confirm="قرارداد خاتمه یابد؟"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="خاتمه قرارداد با تصمیم مدیر کانال"/>@Html.AntiForgeryToken()<button class="link-button link-button--danger" type="submit">خاتمه</button></form>}</div></div>}
</div></section>

<section class="panel"><div class="panel-heading"><div><strong>Territoryهای نماینده</strong><small>کنترل هم‌پوشانی و انحصار پیش از تأیید</small></div></div><div class="record-list">
@if(Model.Territories.Count == 0){<p class="empty-inline">Territory ثبت نشده است.</p>}
@foreach(var item in Model.Territories){<div><span><strong>@item.TerritoryName · @TerritoryStatusLabel(item.Status)</strong><small>@(item.IsExclusive ? "انحصاری" : "غیرانحصاری") · از @item.ValidFromUtc.ToString("yyyy/MM/dd") · درخواست: @item.RequestedBy</small></span><div class="inline-actions">@if(item.Status == DealerTerritoryStatus.Proposed && Model.CanApproveTerritory && item.RequestedByUserId != User.CrmUserId()){<form method="post" action="/dealers/@Model.Dealer.Id/territories/@item.Id/approve" hx-post="/dealers/@Model.Dealer.Id/territories/@item.Id/approve"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="تعارض کانال بررسی شد"/>@Html.AntiForgeryToken()<button class="link-button" type="submit">تأیید تخصیص</button></form>}@if(item.Status == DealerTerritoryStatus.Active && Model.CanApproveTerritory && (Model.Dealer.Status != DealerStatus.Active || Model.Territories.Count(x => x.Status == DealerTerritoryStatus.Active) > 1)){<form method="post" action="/dealers/@Model.Dealer.Id/territories/@item.Id/end" hx-post="/dealers/@Model.Dealer.Id/territories/@item.Id/end" data-confirm="تخصیص Territory پایان یابد؟"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="پایان تخصیص با تصمیم مدیر کانال"/>@Html.AntiForgeryToken()<button class="link-button link-button--danger" type="submit">پایان تخصیص</button></form>}</div></div>}
</div></section>

<section class="panel"><div class="panel-heading"><div><strong>سبد مشتریان</strong><small>نماینده فقط همین مشتریان تخصیص‌یافته را در Portal می‌بیند</small></div></div><div class="record-list">
@if(Model.Customers.Count == 0){<p class="empty-inline">مشتری تخصیص‌یافته‌ای وجود ندارد.</p>}
@foreach(var item in Model.Customers){<div><span><strong>@item.CustomerName</strong><small>@item.CustomerCode · @item.BranchId · @(item.IsActive ? "فعال" : $"پایان‌یافته؛ {item.EndReason}")</small></span><div class="inline-actions"><b>@(item.Balance.HasValue ? $"{item.Balance:N0}" : "محرمانه")</b>@if(item.IsActive && Model.CanAssignCustomer){<form method="post" action="/dealers/@Model.Dealer.Id/customers/@item.Id/end" hx-post="/dealers/@Model.Dealer.Id/customers/@item.Id/end" data-confirm="ارتباط این مشتری با نماینده پایان یابد؟"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input type="hidden" name="Reason" value="خروج مشتری از سبد نماینده"/>@Html.AntiForgeryToken()<button class="link-button link-button--danger" type="submit">حذف از سبد</button></form>}</div></div>}
</div></section>

<section class="panel"><div class="panel-heading"><div><strong>تاریخچه وضعیت</strong><small>Actor، دلیل و زمان تغییر</small></div></div><div class="timeline-list">@foreach(var item in Model.History){<div><i></i><span><strong>@(item.FromStatus.HasValue ? DealerStatusLabel(item.FromStatus.Value) : "شروع") ← @DealerStatusLabel(item.ToStatus)</strong><small>@item.Reason · @item.ChangedBy</small><time>@item.ChangedAtUtc.ToString("yyyy/MM/dd HH:mm")</time></span></div>}</div></section>
<div id="assurance" hx-get="/dealers/@Model.Dealer.Id/assurance" hx-trigger="load" hx-swap="outerHTML"></div>
