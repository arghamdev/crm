@model UserDetailsDto
@{ ViewData["Title"] = "امنیت حساب"; var currentSession = User.CrmSessionId(); var now = DateTimeOffset.UtcNow; }
<header class="page-header"><div><span class="eyebrow">امنیت حساب</span><h1>نشست‌های من</h1><p>مشاهده دستگاه‌ها و خروج از سایر نشست‌ها</p></div><form method="post" action="/account/security/revoke-others" data-confirm="همه نشست‌های دیگر باطل شوند؟">@Html.AntiForgeryToken()<button class="button button--soft-danger" type="submit">ابطال همه نشست‌های دیگر</button></form></header>
@if (TempData["SecurityMessage"] is string message) { <section class="demo-alert"><strong>انجام شد</strong><span>@message</span></section> }
<section class="panel table-panel"><div class="toolbar"><strong>نشست‌ها</strong><span class="muted">Context هر دستگاه مستقل است و خروج، نشست را سمت سرور باطل می‌کند.</span></div><div class="table-wrap"><table><thead><tr><th>نشست</th><th>محیط کاری</th><th>ایجاد</th><th>آخرین فعالیت</th><th>انقضا</th><th>عامل کاربر</th><th>وضعیت</th></tr></thead><tbody>@foreach(var session in Model.Sessions){ var active = session.RevokedAtUtc is null && session.IdleExpiresAtUtc > now && session.AbsoluteExpiresAtUtc > now; <tr><td>@(session.Id == currentSession ? "جاری" : "دستگاه دیگر")</td><td><code>@(session.SelectedCompanyId ?? "—")/@(session.SelectedBranchId ?? "*")</code></td><td>@session.IssuedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@session.LastSeenAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@session.AbsoluteExpiresAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@(session.UserAgentSummary.Length > 42 ? session.UserAgentSummary[..42] + "…" : session.UserAgentSummary)</td><td><span class="badge @(active ? "badge--success" : "badge--neutral")"><span></span>@(active ? "فعال" : "پایان‌یافته")</span></td></tr>}</tbody></table></div></section>
