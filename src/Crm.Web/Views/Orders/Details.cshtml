@model OrderDetailsDto
@using Crm.Domain.Commercial
@functions {
    private static OrderRequestStatus Next(OrderRequestStatus value) => value switch { OrderRequestStatus.ErpAccepted => OrderRequestStatus.Allocated, OrderRequestStatus.Allocated => OrderRequestStatus.Delivered, OrderRequestStatus.Delivered => OrderRequestStatus.Invoiced, OrderRequestStatus.Invoiced => OrderRequestStatus.Paid, _ => value };
    private static string NextText(OrderRequestStatus value) => value switch { OrderRequestStatus.Allocated => "ثبت تخصیص", OrderRequestStatus.Delivered => "ثبت تحویل", OrderRequestStatus.Invoiced => "ثبت فاکتور", OrderRequestStatus.Paid => "ثبت پرداخت", _ => value.ToString() };
}
@{ ViewData["Title"] = $"سفارش {Model.Order.Code}"; var next = Next(Model.Order.Status); }
<header class="page-header"><div><span class="eyebrow">Order Request / ERP Projection</span><h1>@Model.Order.Code</h1><p>@Model.Order.Customer — پیشنهاد @Model.Order.QuoteCode</p></div><div class="page-actions">@if(Model.CanOverrideCredit){<a class="button button--primary" href="/orders/@Model.Order.Id/credit-override" hx-get="/orders/@Model.Order.Id/credit-override" hx-target="#drawerBody">Override مالی</a>}<a class="button button--ghost" href="/orders">بازگشت</a></div></header>
<section class="quote-stats"><div><p><small>مبلغ خالص</small><strong>@($"{Model.Order.NetAmount:N0} {Model.Order.CurrencyCode}")</strong></p></div><div><p><small>وضعیت</small><strong>@Model.Order.Status</strong></p></div><div><p><small>شماره ERP</small><strong>@(Model.Order.ErpOrderNumber ?? "ثبت نشده")</strong></p></div></section>
<section class="quote-governance-grid"><article class="panel"><div class="panel-heading"><div><strong>کنترل اعتبار</strong><small>@(Model.CreditSource ?? "هنوز Snapshot دریافت نشده")</small></div></div><div class="credit-grid"><span>سقف اعتبار <b>@($"{Model.CreditLimit:N0}")</b></span><span>مصرف‌شده <b>@($"{Model.CreditUsed:N0}")</b></span><span>سررسیدگذشته <b>@($"{Model.OverdueAmount:N0}")</b></span><span>اعتبار آزاد <b>@($"{Model.AvailableCredit:N0}")</b></span></div>@if(!string.IsNullOrWhiteSpace(Model.CreditReason)){<p class="callout @(Model.IsCreditHold ? "callout--danger" : "")">@Model.CreditReason</p>}<div class="form-stack">@if(Model.CanCheckCredit){<form method="post" action="/orders/@Model.Order.Id/credit-check">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Order.Version"/><button class="button button--primary" type="submit">دریافت Snapshot اعتبار</button></form>}@if(Model.CreditOverrideExpiresAtUtc.HasValue){<small class="muted">مجوز مالی تا @Model.CreditOverrideExpiresAtUtc.Value.ToString("yyyy/MM/dd HH:mm") معتبر است.</small>}</div></article>
<article class="panel"><div class="panel-heading"><div><strong>ارسال ERP</strong><small>Outbox + Retry + Idempotency</small></div></div>@if(Model.Integration is null){<p class="muted">پیامی در Outbox ساخته نشده است.</p>}else{<dl class="meta-list"><div><dt>وضعیت پیام</dt><dd>@Model.Integration.Status</dd></div><div><dt>تلاش</dt><dd>@Model.Integration.AttemptCount</dd></div><div><dt>Idempotency</dt><dd><code>@Model.Integration.IdempotencyKey</code></dd></div><div><dt>Correlation</dt><dd><code>@Model.Integration.CorrelationId</code></dd></div></dl>@if(!string.IsNullOrWhiteSpace(Model.Integration.LastError)){<p class="callout callout--danger">@Model.Integration.LastError</p>}}<div class="form-stack">@if(Model.CanSubmit){<form method="post" action="/orders/@Model.Order.Id/queue" data-confirm="درخواست در صف ERP قرار گیرد؟">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Order.Version"/><button class="button button--primary" type="submit">قرار دادن در Outbox</button></form>}@if(Model.CanProcessIntegration && Model.Integration is not null){<form method="post" action="/orders/@Model.Order.Id/process">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedOrderVersion" value="@Model.Order.Version"/><input type="hidden" name="ExpectedMessageVersion" value="@Model.Integration.Version"/><label class="field"><span>پاسخ شبیه‌سازی‌شده ERP</span><select name="SimulatedOutcome"><option value="Accepted">Accepted</option><option value="Pending">Pending</option><option value="TransientFailure">Transient Failure / Retry</option><option value="Rejected">Rejected</option></select></label><button class="button button--primary" type="submit">اجرای Worker نمونه</button></form>}</div></article></section>
@if(Model.CanAdvanceProjection){<section class="panel"><div class="panel-heading"><div><strong>همگام‌سازی مرحله بعد ERP</strong><small>CRM مالک این وضعیت‌ها نیست و فقط Projection را ثبت می‌کند</small></div></div><form class="inline-form" method="post" action="/orders/@Model.Order.Id/advance">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.Order.Version"/><input type="hidden" name="TargetStatus" value="@next"/><label class="field"><span>مرجع خارجی *</span><input name="ExternalReference" required placeholder="شماره تخصیص، تحویل، فاکتور یا پرداخت"/></label><button class="button button--primary" type="submit">@NextText(next)</button></form></section>}
<section class="quote-governance-grid"><article class="panel"><div class="panel-heading"><div><strong>تصمیم‌های اعتباری</strong><small>Snapshot و Override مالی</small></div></div>@if(Model.CreditDecisions.Count==0){<p class="muted">تصمیمی ثبت نشده است.</p>}@foreach(var item in Model.CreditDecisions){<div class="timeline-item"><div><strong>@item.Decision — @item.Source</strong><p>@item.Reason</p><small>@item.DecidedBy · @item.DecidedAtUtc.ToString("yyyy/MM/dd HH:mm")</small></div></div>}</article><article class="panel"><div class="panel-heading"><div><strong>تلاش‌های اتصال</strong><small>هر تلاش با نتیجه مستقل</small></div></div>@if(Model.Attempts.Count==0){<p class="muted">تلاشی ثبت نشده است.</p>}@foreach(var item in Model.Attempts){<div class="timeline-item"><div><strong>تلاش @item.AttemptNumber — @item.Outcome</strong><p>@item.Detail</p><small>@item.AttemptedAtUtc.ToString("yyyy/MM/dd HH:mm:ss") · @(item.ExternalReference ?? "بدون مرجع")</small></div></div>}</article></section>
<section class="panel"><div class="panel-heading"><div><strong>تاریخچه وضعیت سفارش</strong><small>Audit با منبع تغییر</small></div></div>@foreach(var item in Model.History){<div class="timeline-item"><div><strong>@(item.FromStatus?.ToString() ?? "شروع") → @item.ToStatus</strong><p>@item.Reason</p><small>@item.Source · @item.ChangedBy · @item.ChangedAtUtc.ToString("yyyy/MM/dd HH:mm")</small></div></div>}</section>
