@model OverrideOrderCreditCommand
@{ var orderId = (Guid)ViewBag.OrderId; }
<form class="drawer-form" method="post" action="/orders/@orderId/credit-override" hx-post="/orders/@orderId/credit-override" hx-target="#drawerBody" hx-swap="innerHTML">
    @Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="form-section"><h3>مجوز استثنای اعتباری</h3><p class="muted">تصمیم مالی زمان‌دار، مستقل از Snapshot حسابداری ثبت می‌شود و در Audit باقی می‌ماند.</p><div class="form-grid"><label class="field field--full"><span>دلیل Override *</span><textarea asp-for="Reason" rows="4" required></textarea><span asp-validation-for="Reason" class="field-error"></span></label><label class="field field--full"><span>اعتبار مجوز تا *</span><input asp-for="ExpiresAtUtc" type="datetime-local"/><span asp-validation-for="ExpiresAtUtc" class="field-error"></span></label></div></section>
    <div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت مجوز مالی</button></div>
</form>
