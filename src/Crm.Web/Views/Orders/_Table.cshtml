@model IReadOnlyList<OrderSummaryDto>
@functions {
    private static string Text(OrderRequestStatus value) => value switch { OrderRequestStatus.Draft => "جدید", OrderRequestStatus.CreditApproved => "اعتبار تأیید", OrderRequestStatus.CreditHold => "توقف اعتباری", OrderRequestStatus.SubmissionPending => "در صف ERP", OrderRequestStatus.IntegrationFailed => "خطای اتصال", OrderRequestStatus.ErpRejected => "رد ERP", OrderRequestStatus.ErpAccepted => "پذیرفته ERP", OrderRequestStatus.Allocated => "تخصیص", OrderRequestStatus.Delivered => "تحویل", OrderRequestStatus.Invoiced => "فاکتور", OrderRequestStatus.Paid => "پرداخت", _ => value.ToString() };
    private static string Css(OrderRequestStatus value) => value switch { OrderRequestStatus.CreditApproved or OrderRequestStatus.ErpAccepted or OrderRequestStatus.Paid => "badge--success", OrderRequestStatus.CreditHold or OrderRequestStatus.SubmissionPending => "badge--warning", OrderRequestStatus.IntegrationFailed or OrderRequestStatus.ErpRejected => "badge--danger", _ => "badge--neutral" };
}
<div class="table-wrap"><table><thead><tr><th>درخواست / پیشنهاد</th><th>مشتری</th><th>مبلغ خالص</th><th>شماره ERP</th><th>آخرین همگام‌سازی</th><th>وضعیت</th><th></th></tr></thead><tbody>
@foreach(var item in Model){<tr><td><code class="code-strong">@item.Code</code><small class="cell-sub">@item.QuoteCode</small></td><td><strong>@item.Customer</strong><small class="cell-sub">@item.BranchId · @(item.TerritoryId ?? "—")</small></td><td>@($"{item.NetAmount:N0} {item.CurrencyCode}")</td><td>@(item.ErpOrderNumber ?? "—")</td><td>@(item.LastSynchronizedAtUtc?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td><td><span class="badge @Css(item.Status)"><span></span>@Text(item.Status)</span></td><td><a class="link-button" href="/orders/@item.Id">مشاهده</a></td></tr>}
</tbody></table></div><div class="table-footer"><span>@Model.Count درخواست</span><span>Source of Truth: ERP / Accounting</span></div>
