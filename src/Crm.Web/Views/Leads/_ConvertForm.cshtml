@model ConvertLeadCommand
@{ var lead = (LeadDto)ViewBag.Lead; var customers = ViewBag.Customers as IReadOnlyList<CustomerDto> ?? []; string Local(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); }
<form class="drawer-form" method="post" action="/leads/@lead.Id/convert" hx-post="/leads/@lead.Id/convert" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>تبدیل @lead.Code</h3><div class="form-grid"><label class="field field--full"><span>مشتری موجود (اختیاری)</span><select asp-for="ExistingCustomerId"><option value="">ایجاد مشتری جدید از لید</option>@foreach(var item in customers){<option value="@item.Id">@item.Name — @item.Code</option>}</select></label><label class="field field--full"><span>عنوان فرصت *</span><input asp-for="OpportunityTitle"/></label><label class="field"><span>ارزش فرصت (ریال) *</span><input asp-for="Value" type="number" min="1"/></label><label class="field"><span>تاریخ بستن مورد انتظار *</span><input asp-for="ExpectedCloseAtUtc" type="datetime-local" value="@Local(Model.ExpectedCloseAtUtc)"/></label></div></section><div class="identity-form-note">در صورت انتخاب مشتری موجود، هم‌شرکتی و هم‌شعبه بودن سمت سرور کنترل می‌شود.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ایجاد مشتری و فرصت</button></div></form>
