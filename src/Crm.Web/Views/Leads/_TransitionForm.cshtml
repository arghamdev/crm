@model TransitionLeadCommand
@{ var lead = (LeadDto)ViewBag.Lead; string Local(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? ""; }
<form class="drawer-form" method="post" action="/leads/@lead.Id/transition" hx-post="/leads/@lead.Id/transition" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>تغییر وضعیت @lead.Code</h3><div class="form-grid"><label class="field field--full"><span>وضعیت مقصد *</span><select asp-for="TargetStatus"><option value="Contacted">تماس‌شده</option><option value="Qualified">واجد شرایط</option><option value="Nurture">پرورش</option><option value="Disqualified">ردشده</option><option value="Duplicate">تکراری</option><option value="Invalid">نامعتبر</option></select></label><label class="field"><span>امتیاز</span><input asp-for="Score" type="number" min="0" max="100"/></label><label class="field"><span>زمان اقدام بعدی</span><input asp-for="NextActionAtUtc" type="datetime-local" value="@Local(Model.NextActionAtUtc)"/></label><label class="field field--full"><span>اقدام بعدی</span><input asp-for="NextAction"/></label><label class="field field--full"><span>دلیل تغییر *</span><textarea asp-for="Reason" rows="3"></textarea></label></div></section><div class="identity-form-note">برای Qualified ابتدا باید وضعیت تماس‌شده باشد و امتیاز حداقل ۶۰ ثبت شود.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت تغییر</button></div></form>
