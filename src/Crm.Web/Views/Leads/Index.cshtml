@model LeadListPage
@{ ViewData["Title"] = "مدیریت سرنخ‌های فروش"; }
<header class="list-head">
    <div class="list-head__title">
        <span class="list-head__icon"><svg><use href="#i-lead"/></svg></span>
        <div><h1>مدیریت سرنخ‌های فروش</h1><p>ثبت، ارجاع، پیگیری و تبدیل سرنخ‌ها به فرصت فروش؛ هر سرنخ با مالک، مهلت تماس و اقدام بعدی</p></div>
    </div>
    @if (Model.List.CanCreate)
    {
        <div class="list-head__actions">
            <a class="button button--ghost button--outline" href="/leads/import" hx-get="/leads/import" hx-target="#drawerBody"><svg><use href="#i-upload"/></svg>ورود اطلاعات</a>
            <a class="button button--primary" href="/leads/create" hx-get="/leads/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg>سرنخ جدید</a>
        </div>
    }
</header>
<partial name="_List" model="Model" />
