@model AssignLeadCommand
@{ var lead = (LeadDto)ViewBag.Lead; var owners = ViewBag.Owners as IReadOnlyList<SalesOwnerOptionDto> ?? []; string Local(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); }
<form class="drawer-form" method="post" action="/leads/@lead.Id/assign" hx-post="/leads/@lead.Id/assign" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>تخصیص @lead.Code</h3><div class="form-grid"><label class="field field--full"><span>مالک جدید *</span><select asp-for="OwnerUserId">@foreach(var owner in owners){<option value="@owner.UserId">@owner.DisplayName — @owner.RoleLabel</option>}</select></label><label class="field field--full"><span>مهلت تماس اولیه *</span><input asp-for="FirstContactDueAtUtc" type="datetime-local" value="@Local(Model.FirstContactDueAtUtc)"/></label><label class="field field--full"><span>دلیل *</span><textarea asp-for="Reason" rows="3"></textarea></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت تخصیص</button></div></form>
