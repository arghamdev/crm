@model LeadDetailsDto
@{ ViewData["Title"] = "جزئیات سرنخ"; var lead = Model.Lead; }
@functions {
    private static string StatusText(LeadStatus value) => value switch { LeadStatus.New => "جدید", LeadStatus.Assigned => "تخصیص‌یافته", LeadStatus.Contacted => "تماس‌شده", LeadStatus.Qualified => "واجد شرایط", LeadStatus.Nurture => "پرورش", LeadStatus.Disqualified => "ردشده", LeadStatus.Duplicate => "تکراری", LeadStatus.Invalid => "نامعتبر", _ => "تبدیل‌شده" };
}
<nav class="breadcrumb"><a href="/leads">سرنخ‌ها</a><svg><use href="#i-chevron"/></svg><span>@lead.Code</span></nav>
<section class="customer-hero"><div class="customer-hero__identity"><span class="entity-avatar entity-avatar--blue">@lead.Name[..1]</span><div><div class="title-line"><h1>@lead.Name</h1><span class="badge @(lead.Status == LeadStatus.Qualified ? "badge--success" : "badge--info")"><span></span>@StatusText(lead.Status)</span></div><p>@lead.Code · @lead.Source · امتیاز @lead.Score</p><div class="contact-line"><span>مالک: @lead.Owner</span><i></i><span>@lead.BranchId / @(lead.TerritoryId ?? "*")</span><i></i><span>نسخه @lead.Version</span></div></div></div><div class="page-actions">@if(Model.CanAssign){<a class="button button--ghost" href="/leads/@lead.Id/assign" hx-get="/leads/@lead.Id/assign" hx-target="#drawerBody">تخصیص</a>}@if(Model.CanUpdate){<a class="button button--ghost" href="/leads/@lead.Id/transition" hx-get="/leads/@lead.Id/transition" hx-target="#drawerBody">تغییر وضعیت</a>}@if(Model.CanConvert){<a class="button button--primary" href="/leads/@lead.Id/convert" hx-get="/leads/@lead.Id/convert" hx-target="#drawerBody">تبدیل</a>}</div></section>
<section class="customer-kpis"><article><small>SLA تماس اول</small><strong>@lead.SlaState</strong><span>@(lead.FirstContactDueAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</span></article><article><small>آخرین فعالیت</small><strong>@lead.LastActivityAtUtc?.ToLocalTime().ToString("MM/dd HH:mm")</strong><span>@(lead.StatusReason ?? "بدون شرح")</span></article><article><small>اقدام بعدی</small><strong>@(lead.NextAction ?? "—")</strong><span>@(lead.NextActionAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "بدون زمان")</span></article><article><small>مقصد تبدیل</small><strong>@(lead.CustomerId.HasValue ? "ایجاد شده" : "هنوز تبدیل نشده")</strong><span>@(lead.ConvertedOpportunityId?.ToString() ?? "—")</span></article></section>
<section class="customer-360-grid"><article class="panel"><div class="panel-heading"><div><strong>اطلاعات تماس</strong><small>داده ورودی لید</small></div></div><dl class="details-grid"><div><dt>شخص تماس</dt><dd>@(lead.Contact.Length == 0 ? "—" : lead.Contact)</dd></div><div><dt>تلفن</dt><dd>@(lead.Phone ?? "—")</dd></div><div><dt>ایمیل</dt><dd>@(lead.Email?.ToLowerInvariant() ?? "—")</dd></div><div><dt>تخصیص</dt><dd>@(lead.AssignedAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</dd></div></dl></article><article class="panel"><div class="panel-heading"><div><strong>کنترل تبدیل</strong><small>فقط Qualified قابل تبدیل است</small></div></div><p class="empty-inline">تبدیل موفق به‌صورت اتمیک مشتری/فرصت، ارتباط مبدأ، Timeline و تاریخچه وضعیت را ایجاد می‌کند.</p></article></section>
<section class="panel table-panel"><div class="panel-heading"><div><strong>تاریخچه وضعیت</strong><small>ممیزی تغییرات با عامل و دلیل</small></div></div><div class="table-wrap"><table><thead><tr><th>زمان</th><th>از</th><th>به</th><th>عامل</th><th>دلیل</th></tr></thead><tbody>@if(Model.History.Count == 0){<tr><td colspan="5" class="empty-cell">تاریخچه‌ای ثبت نشده است.</td></tr>}@foreach(var item in Model.History){<tr><td>@item.ChangedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@(item.FromStatus?.ToString() ?? "ایجاد")</td><td>@StatusText(item.ToStatus)</td><td>@item.ChangedByName</td><td>@item.Reason</td></tr>}</tbody></table></div></section>
