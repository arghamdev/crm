@model CustomerListPage
@{ ViewData["Title"] = "مشتریان و حساب‌ها"; }
<header class="list-head">
    <div class="list-head__title">
        <span class="list-head__icon"><svg><use href="#i-users"/></svg></span>
        <div><h1>مشتریان و حساب‌ها</h1><p>پرونده یکپارچه مشتریان، مشتریان بالقوه، تأمین‌کنندگان و شرکا؛ با کیفیت داده و پیگیری بعدی هر حساب</p></div>
    </div>
    <div class="list-head__actions">
        <a class="button button--ghost" href="/customers/data-quality"><svg><use href="#i-check"/></svg>کیفیت داده</a>
        @if (Model.List.CanReviewDuplicates) { <a class="button button--ghost" href="/customers/duplicates"><svg><use href="#i-copy"/></svg>رکوردهای مشابه</a> }
        @if (Model.List.CanCreate) { <a class="button button--primary" href="/customers/create" hx-get="/customers/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg>مشتری جدید</a> }
    </div>
</header>
<partial name="_List" model="Model" />
