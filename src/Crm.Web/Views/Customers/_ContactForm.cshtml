@model AddCustomerContactCommand
@{ var customerId = (Guid)ViewBag.CustomerId; }
<form class="drawer-form" method="post" action="/customers/@customerId/contacts/create" hx-post="/customers/@customerId/contacts/create" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>شخص تماس جدید</h3><div class="form-grid"><label class="field field--full"><span>نام و نام خانوادگی *</span><input asp-for="FullName"/></label><label class="field"><span>سمت/نقش</span><input asp-for="Role"/></label><label class="field"><span>تلفن</span><input asp-for="Phone"/></label><label class="field"><span>ایمیل</span><input asp-for="Email" type="email"/></label><label class="field"><span>رضایت ارتباطی</span><select asp-for="ConsentStatus"><option value="Unknown">نامشخص</option><option value="Granted">مجاز</option><option value="Revoked">لغوشده</option></select></label><label class="consent-row"><input asp-for="IsPrimary"/><span>تماس اصلی مشتری</span></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">افزودن تماس</button></div></form>

