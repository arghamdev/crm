@model IReadOnlyList<DuplicateCandidateDto>
@{ ViewData["Title"] = "بررسی رکوردهای مشابه"; }
<header class="page-header"><div><span class="eyebrow">Customer Data Quality</span><h1>بررسی رکوردهای مشابه</h1><p>پس از تأیید شباهت، ادغام کنترل‌شده با پیش‌نمایش و امکان بازگردانی انجام می‌شود.</p></div><div class="page-actions"><a class="button button--ghost" href="/customers/merges">تاریخچه ادغام</a><a class="button button--ghost" href="/customers/data-quality">کیفیت داده</a><a class="button button--primary" href="/customers">مشتریان</a></div></header><section class="identity-banner"><span><svg><use href="#i-users"/></svg></span><div><strong>هیچ رکوردی در Merge حذف نمی‌شود</strong><p>روابط با CustomerId منتقل، رکورد دوم غیرفعال و Manifest انتقال برای Unmerge ذخیره می‌شود.</p></div><b>@Model.Count(x => x.Status == DuplicateReviewStatus.Pending) در انتظار</b></section><div id="duplicateTable" hx-get="/customers/duplicates/table" hx-trigger="duplicateChanged from:body" hx-swap="innerHTML"><partial name="_DuplicateTable" model="Model"/></div>
