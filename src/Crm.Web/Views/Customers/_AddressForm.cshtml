@model AddCustomerAddressCommand
@{ var customerId = (Guid)ViewBag.CustomerId; }
<form class="drawer-form" method="post" action="/customers/@customerId/addresses/create" hx-post="/customers/@customerId/addresses/create" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>آدرس جدید</h3><div class="form-grid"><label class="field"><span>نوع</span><select asp-for="Type"><option value="Registered">ثبت‌شده</option><option value="Billing">صورتحساب</option><option value="Shipping">ارسال</option><option value="Visit">بازدید</option><option value="Branch">شعبه</option><option value="ServiceCenter">مرکز خدمات</option><option value="SalesCenter">مرکز فروش</option></select></label><label class="field"><span>عنوان *</span><input asp-for="Title"/></label><label class="field"><span>استان</span><input asp-for="Province"/></label><label class="field"><span>شهر</span><input asp-for="City"/></label><label class="field field--full"><span>نشانی *</span><textarea asp-for="AddressLine" rows="3"></textarea></label><label class="field"><span>کدپستی</span><input asp-for="PostalCode"/></label><label class="consent-row"><input asp-for="IsPrimary"/><span>آدرس اصلی مشتری</span></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">افزودن آدرس</button></div></form>

