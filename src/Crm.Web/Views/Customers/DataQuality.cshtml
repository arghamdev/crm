@model IReadOnlyList<CustomerDataQualityRowDto>
@{ ViewData["Title"] = "کیفیت داده مشتری"; var average = Model.Count == 0 ? 0 : (int)Model.Average(x => x.Customer.DataQualityScore); }
<header class="page-header"><div><span class="eyebrow">Data Quality Dashboard</span><h1>کیفیت داده مشتری</h1><p>امتیاز قابل توضیح براساس تکمیل Master Data، Contact، Address و تازگی ERP</p></div><div class="page-actions">@if (ViewBag.CanReviewDuplicates == true) { <a class="button button--ghost" href="/customers/duplicates">رکوردهای مشابه</a> }<a class="button button--primary" href="/customers">مشتریان</a></div></header><section class="mini-stats"><div><p><small>میانگین کیفیت</small><strong>@average٪</strong></p></div><div><p><small>کمتر از ۷۰٪</small><strong>@Model.Count(x => x.Customer.DataQualityScore < 70)</strong></p></div><div><p><small>موارد بحرانی</small><strong>@Model.Sum(x => x.Issues.Count(i => i.Severity == "High"))</strong></p></div></section><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>مشتری</th><th>امتیاز</th><th>موارد High</th><th>موارد Medium</th><th>شرح</th><th></th></tr></thead><tbody>@foreach(var row in Model){<tr><td><strong>@row.Customer.Name</strong><small class="table-subline">@row.Customer.Code · @row.Customer.Branch</small></td><td><b>@row.Customer.DataQualityScore٪</b></td><td>@row.Issues.Count(x => x.Severity == "High")</td><td>@row.Issues.Count(x => x.Severity == "Medium")</td><td>@string.Join("؛ ", row.Issues.Take(3).Select(x => x.Message))</td><td><a class="link-button" href="/customers/@row.Customer.Id">@(ViewBag.CanUpdateCustomer == true ? "اصلاح" : "مشاهده")</a></td></tr>}</tbody></table></div></section>
