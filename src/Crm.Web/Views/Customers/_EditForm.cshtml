@model CustomerEditDto
<form class="drawer-form" method="post" action="/customers/@Model.Id/edit" hx-post="/customers/@Model.Id/edit" hx-target="#drawerBody" hx-swap="innerHTML">
    @Html.AntiForgeryToken()<input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="form-section"><h3>Master Data مشتری</h3><div class="form-grid"><label class="field"><span>کد</span><input value="@Model.Code" readonly/></label><label class="field"><span>نوع</span><input value="@(Model.Kind == CustomerKind.Legal ? "حقوقی" : "حقیقی")" readonly/></label><label class="field field--full"><span>نام *</span><input name="Name" value="@Model.Name"/><span asp-validation-for="Name" class="field-error"></span></label><label class="field"><span>شناسه ملی</span><input name="NationalId" value="@Model.NationalId"/></label><label class="field"><span>شهر</span><input name="City" value="@Model.City"/></label><label class="field"><span>تلفن اصلی</span><input name="PrimaryPhone" value="@Model.PrimaryPhone"/></label><label class="field"><span>ایمیل اصلی</span><input type="email" name="PrimaryEmail" value="@Model.PrimaryEmail"/></label><label class="field"><span>مالک حساب</span><input name="Owner" value="@Model.Owner"/></label><label class="field"><span>شعبه *</span><select name="BranchId">@foreach(var item in Model.Branches){<option value="@item.Id" selected="@(item.Id == Model.BranchId)">@item.Name — @item.Code</option>}</select></label><label class="field"><span>قلمرو</span><select name="TerritoryId"><option value="">بدون قلمرو</option>@foreach(var item in Model.Territories){<option value="@item.Id" selected="@(item.Id == Model.TerritoryId)">@item.Name — @item.Code</option>}</select></label><label class="field"><span>بخش‌بندی</span><select name="Segment"><option selected="@(Model.Segment == "استاندارد")">استاندارد</option><option selected="@(Model.Segment == "رشد")">رشد</option><option selected="@(Model.Segment == "کلیدی")">کلیدی</option></select></label><label class="field field--full"><span>دلیل تغییر مالکیت/دامنه</span><textarea name="OwnershipChangeReason" rows="2" placeholder="در صورت تغییر مالک، شعبه یا قلمرو الزامی است"></textarea></label></div></section>
    <div class="identity-form-note">نسخه مورد انتظار: @Model.ExpectedVersion. تغییر مالکیت، رکورد تاریخچه جدید ایجاد می‌کند.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ذخیره</button></div>
</form>

