@model Customer360Dto
@{
    ViewData["Title"] = "نمای ۳۶۰ مشتری";
    var customer = Model.Customer;
    var creditUsage = customer.CreditLimit <= 0 ? 0 : Math.Min(100, decimal.ToInt32(customer.Balance / customer.CreditLimit * 100));
}
<nav class="breadcrumb"><a href="/customers">مشتریان</a><svg><use href="#i-chevron"/></svg><span>@customer.Code</span></nav>
<section class="customer-hero"><div class="customer-hero__identity">@if (Model.Profile?.HasLogo == true) { <img class="customer-logo" src="/customers/@customer.Id/logo?v=@customer.Version" alt="عکس @customer.Name" /> } else { <span class="entity-avatar">@customer.Name[..1]</span> }<div><div class="title-line"><h1>@customer.Name</h1><span class="badge @(customer.Status == CustomerStatus.Active ? "badge--success" : customer.Status == CustomerStatus.Inactive ? "badge--neutral" : "badge--warning")"><span></span>@customer.Status</span></div><p>@customer.Code · @customer.Segment · @(customer.Kind == CustomerKind.Legal ? "حقوقی" : "حقیقی")</p><div class="contact-line"><span>@customer.City</span><i></i><span>مالک: @customer.Owner</span><i></i><span>کیفیت داده: @customer.DataQualityScore٪</span></div></div></div><div class="page-actions">@if (ViewBag.CanUpdateCustomer == true && customer.Status != CustomerStatus.Inactive) { <a class="button button--ghost" href="/customers/@customer.Id/edit" hx-get="/customers/@customer.Id/edit" hx-target="#drawerBody">ویرایش</a> }<a class="button button--ghost" href="/customers">بازگشت</a></div></section>
<section class="customer-kpis"><article><small>مانده حساب</small><strong>@(customer.FinancialMasked ? "محرمانه" : $"{customer.Balance:N0} ریال")</strong><span>ERP Projection</span></article><article><small>سقف اعتبار</small><strong>@(customer.FinancialMasked ? "محرمانه" : $"{customer.CreditLimit:N0} ریال")</strong><span>@(customer.FinancialMasked ? "نیازمند مجوز مالی" : $"مصرف {creditUsage}٪")</span></article><article><small>مالک حساب</small><strong>@customer.Owner</strong><span>@customer.Branch</span></article><article><small>کیفیت داده</small><strong>@customer.DataQualityScore٪</strong><span>@Model.DataQualityIssues.Count مورد قابل اصلاح</span></article></section>
<section class="customer-360-grid">
    <article class="panel"><div class="panel-heading"><div><strong>Master Data</strong><small>مالک داده: CRM</small></div>@if (ViewBag.CanUpdateCustomer == true && customer.Status != CustomerStatus.Inactive) { <a class="link-button" href="/customers/@customer.Id/edit" hx-get="/customers/@customer.Id/edit" hx-target="#drawerBody">ویرایش</a> }</div><dl class="details-grid"><div><dt>نام</dt><dd>@customer.Name</dd></div><div><dt>شناسه ملی</dt><dd><bdi dir="ltr">@(customer.NationalId ?? "—")</bdi></dd></div><div><dt>شهر</dt><dd>@customer.City</dd></div><div><dt>شعبه</dt><dd>@customer.Branch</dd></div><div><dt>قلمرو</dt><dd>@(customer.TerritoryId ?? "—")</dd></div><div><dt>تلفن</dt><dd><bdi dir="ltr">@(customer.PrimaryPhone ?? "—")</bdi></dd></div><div><dt>ایمیل</dt><dd><bdi dir="ltr">@(customer.PrimaryEmail?.ToLowerInvariant() ?? "—")</bdi></dd></div><div><dt>نسخه</dt><dd>@customer.Version</dd></div></dl></article>
    <article class="panel"><div class="panel-heading"><div><strong>منبع و تازگی داده</strong><small>System of Record</small></div></div><div class="source-list">@foreach (var source in Model.Sources) { <div><span><strong>@source.Section</strong><small>@source.SystemOfRecord</small></span><span class="badge @(source.FreshnessStatus == "به‌روز" ? "badge--success" : "badge--warning")"><span></span>@source.FreshnessStatus</span><time>@(source.LastSynchronizedAtUtc?.ToString("yyyy/MM/dd HH:mm") ?? "نامشخص")</time></div> }</div></article>
</section>
@if (Model.Profile is { } profile)
{
    string V(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    <section class="panel customer-profile-panel"><div class="panel-heading"><div><strong>@(customer.Kind == CustomerKind.Legal ? "اطلاعات شرکت و نماینده" : "اطلاعات شخص")</strong><small>@(profile.Masked ? "برخی مقادیر به‌دلیل سطح دسترسی پوشانده شده‌اند" : "فرم تعریف مشتری")</small></div></div>
        <dl class="details-grid details-grid--4">
            <div><dt>نوع فعالیت</dt><dd>@V(profile.ActivityType)</dd></div>
            <div><dt>@(customer.Kind == CustomerKind.Legal ? "نماینده" : "نام و نام خانوادگی")</dt><dd>@V(string.Join(' ', new[] { profile.Title, profile.FirstName, profile.LastName }.Where(x => x is not null)))</dd></div>
            <div><dt>سمت</dt><dd>@V(profile.Position)</dd></div>
            <div><dt>نام شرکت / فروشگاه</dt><dd>@V(profile.LegalName)</dd></div>
            <div><dt>همراه</dt><dd><bdi dir="ltr">@V(string.Join(" / ", new[] { profile.Mobile1, profile.Mobile2 }.Where(x => x is not null)))</bdi></dd></div>
            <div><dt>تلفن ثابت</dt><dd><bdi dir="ltr">@V(string.Join(" / ", new[] { profile.Phone1, profile.Phone2 }.Where(x => x is not null)))</bdi></dd></div>
            <div><dt>استان</dt><dd>@V(profile.Province)</dd></div>
            <div><dt>کد اقتصادی</dt><dd><bdi dir="ltr">@V(profile.EconomicCode)</bdi></dd></div>
            @if (customer.Kind == CustomerKind.Legal)
            {
                <div><dt>شماره ثبت</dt><dd><bdi dir="ltr">@V(profile.RegistrationNumber)</bdi></dd></div>
                <div><dt>کد ملی نماینده</dt><dd><bdi dir="ltr">@V(profile.RepresentativeNationalCode)</bdi></dd></div>
                <div><dt>تعداد پرسنل</dt><dd>@V(profile.EmployeeCount)</dd></div>
            }
            <div><dt>شماره شناسنامه</dt><dd><bdi dir="ltr">@V(profile.BirthCertificateNumber)</bdi></dd></div>
            <div><dt>تاریخ تولد</dt><dd><bdi dir="ltr">@V(profile.BirthDate)</bdi></dd></div>
            <div><dt>کد حسابداری</dt><dd><bdi dir="ltr">@V(profile.AccountingCode)</bdi></dd></div>
            <div><dt>تاریخ آشنایی</dt><dd><bdi dir="ltr">@V(profile.AcquaintanceDate)</bdi></dd></div>
            <div><dt>نحوه آشنایی</dt><dd>@V(profile.ReferralSource)</dd></div>
            <div><dt>خرید نرم‌افزار</dt><dd>@V(profile.SoftwarePurchase)</dd></div>
            <div><dt>کد اشتراک شعبه</dt><dd><bdi dir="ltr">@V(profile.BranchSubscriptionCode)</bdi></dd></div>
            <div><dt>وب‌سایت</dt><dd>@if (profile.Website is { } site) { <a href="@site" rel="noopener noreferrer" target="_blank" dir="ltr">@site.Replace("https://", "").Replace("http://", "")</a> } else { <text>—</text> }</dd></div>
            @if (!string.IsNullOrWhiteSpace(profile.Notes)) { <div class="details-grid__wide"><dt>توضیحات</dt><dd>@profile.Notes</dd></div> }
        </dl>
    </section>
}
@if (Model.DataQualityIssues.Count > 0)
{
    <section class="panel quality-panel"><div class="panel-heading"><div><strong>موارد کیفیت داده</strong><small>تکمیل این موارد امتیاز Customer 360 را افزایش می‌دهد</small></div><a class="link-button" href="/customers/data-quality">داشبورد کیفیت</a></div><div class="quality-issues">@foreach (var issue in Model.DataQualityIssues) { <span class="quality-issue quality-issue--@issue.Severity.ToLowerInvariant()"><b>@issue.Field</b>@issue.Message</span> }</div></section>
}
<section class="customer-360-grid">
    <article class="panel"><div class="panel-heading"><div><strong>رابط‌های مشتری</strong><small>رضایت ارتباطی در سطح هر رابط</small></div>@if (ViewBag.CanUpdateCustomer == true && customer.Status != CustomerStatus.Inactive) { <a class="link-button" href="/customers/@customer.Id/contacts/create" hx-get="/customers/@customer.Id/contacts/create" hx-target="#drawerBody">افزودن</a> }</div><div class="record-list">@if (Model.Contacts.Count == 0) { <p class="empty-inline">شخص تماسی ثبت نشده است.</p> } @foreach (var item in Model.Contacts.Where(x => x.IsActive)) { <div data-contact="@item.Id"><span class="entity-avatar">@item.FullName[..1]</span><span><strong>@item.FullName @if(item.IsPrimary){<small class="tag">اصلی</small>}</strong><small>@(string.IsNullOrEmpty(item.Role) ? "—" : item.Role) · همراه <bdi dir="ltr">@(item.Mobile ?? "—")</bdi> · تلفن <bdi dir="ltr">@(item.Phone ?? "—")</bdi>@if (item.Extension is not null) { <text> داخلی </text><bdi dir="ltr">@item.Extension</bdi> } · <bdi dir="ltr">@(item.Email?.ToLowerInvariant() ?? "بدون ایمیل")</bdi></small>@if (item.Notes is not null) { <small>@item.Notes</small> }</span><span class="badge @(item.ConsentStatus == ContactConsentStatus.Granted ? "badge--success" : item.ConsentStatus == ContactConsentStatus.Revoked ? "badge--danger" : "badge--warning")"><span></span>@(item.ConsentStatus switch { ContactConsentStatus.Granted => "رضایت دارد", ContactConsentStatus.Revoked => "لغو رضایت", _ => "رضایت نامشخص" })</span>@if (ViewBag.CanUpdateCustomer == true && customer.Status != CustomerStatus.Inactive) { <span class="inline-actions"><a class="link-button" href="/customers/@customer.Id/contacts/@item.Id/edit" hx-get="/customers/@customer.Id/contacts/@item.Id/edit" hx-target="#drawerBody">ویرایش</a><form method="post" action="/customers/@customer.Id/contacts/@item.Id/deactivate" hx-post="/customers/@customer.Id/contacts/@item.Id/deactivate" hx-swap="none" data-confirm="این رابط غیرفعال شود؟">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@item.Version" /><button class="link-button link-button--danger" type="submit">غیرفعال</button></form></span> }</div> }</div></article>
    <article class="panel"><div class="panel-heading"><div><strong>آدرس‌ها</strong><small>ثبت‌شده، صورتحساب، ارسال و بازدید</small></div>@if (ViewBag.CanUpdateCustomer == true && customer.Status != CustomerStatus.Inactive) { <a class="link-button" href="/customers/@customer.Id/addresses/create" hx-get="/customers/@customer.Id/addresses/create" hx-target="#drawerBody">افزودن</a> }</div><div class="record-list">@if (Model.Addresses.Count == 0) { <p class="empty-inline">آدرسی ثبت نشده است.</p> } @foreach (var item in Model.Addresses) { <div><span class="mini-icon"><svg><use href="#i-building"/></svg></span><span><strong>@item.Title @if(item.IsPrimary){<small class="tag">اصلی</small>}</strong><small>@item.Province، @item.City — @item.AddressLine</small></span><code>@item.Type</code></div> }</div></article>
</section>
<section class="panel table-panel"><div class="panel-heading"><div><strong>تاریخچه مالکیت و دامنه</strong><small>هر تغییر با دلیل و بازه اعتبار نگهداری می‌شود</small></div></div><div class="table-wrap"><table><thead><tr><th>مالک</th><th>شعبه</th><th>قلمرو</th><th>شروع</th><th>پایان</th><th>دلیل</th></tr></thead><tbody>@if(Model.OwnershipHistory.Count == 0){<tr><td colspan="6" class="empty-cell">تاریخچه‌ای ثبت نشده است.</td></tr>}@foreach(var item in Model.OwnershipHistory){<tr><td>@item.Owner</td><td>@item.BranchId</td><td>@(item.TerritoryId ?? "—")</td><td>@item.ValidFromUtc.ToString("yyyy/MM/dd")</td><td>@(item.ValidToUtc?.ToString("yyyy/MM/dd") ?? "جاری")</td><td>@item.Reason</td></tr>}</tbody></table></div></section>
<div id="customerActivity" class="lazy-customer-activity" hx-get="/customers/@customer.Id/activity" hx-trigger="load" hx-swap="outerHTML">
    <section class="panel lazy-panel"><strong>Timeline یکپارچه و ارتباطات تجاری</strong><span class="htmx-indicator">در حال بارگذاری…</span><a class="link-button" href="/customers/@customer.Id/activity">بارگذاری دستی</a></section>
</div>
