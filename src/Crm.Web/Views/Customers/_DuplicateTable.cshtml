@model IReadOnlyList<DuplicateCandidateDto>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>رکورد اول</th><th>رکورد دوم</th><th>امتیاز</th><th>دلایل</th><th>وضعیت/تصمیم</th></tr></thead><tbody>
@if(Model.Count == 0){<tr><td colspan="5" class="empty-cell">پرونده‌ای وجود ندارد.</td></tr>}
@foreach(var item in Model){<tr><td><a href="/customers/@item.CustomerId"><strong>@item.CustomerName</strong><small class="table-subline">@item.CustomerCode</small></a></td><td><a href="/customers/@item.PossibleDuplicateCustomerId"><strong>@item.PossibleDuplicateName</strong><small class="table-subline">@item.PossibleDuplicateCode</small></a></td><td><b>@item.Score٪</b></td><td>@item.Reasons</td><td>
@if(item.Status == DuplicateReviewStatus.Pending){<div class="duplicate-actions"><form method="post" action="/customers/duplicates/@item.Id/review" hx-post="/customers/duplicates/@item.Id/review" hx-target="closest td" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="Decision" value="Confirmed"/><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input name="Note" required placeholder="یادداشت تصمیم"/><button class="link-button link-button--danger" type="submit">تأیید مشابه</button></form><form method="post" action="/customers/duplicates/@item.Id/review" hx-post="/customers/duplicates/@item.Id/review" hx-target="closest td" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="Decision" value="Dismissed"/><input type="hidden" name="ExpectedVersion" value="@item.Version"/><input name="Note" required placeholder="دلیل رد"/><button class="link-button" type="submit">رد شباهت</button></form></div>}
else if(item.HasActiveMerge){<span class="badge badge--success"><span></span>ادغام‌شده</span><a class="link-button" href="/customers/merges">مشاهده تاریخچه</a>}
else if(item.Status == DuplicateReviewStatus.Confirmed){<span class="badge badge--warning"><span></span>تأییدشده</span><div class="duplicate-actions"><a class="link-button" href="/customers/duplicates/@item.Id/merge?survivorCustomerId=@item.CustomerId" hx-get="/customers/duplicates/@item.Id/merge?survivorCustomerId=@item.CustomerId" hx-target="#drawerBody">انتخاب رکورد اول</a><a class="link-button" href="/customers/duplicates/@item.Id/merge?survivorCustomerId=@item.PossibleDuplicateCustomerId" hx-get="/customers/duplicates/@item.Id/merge?survivorCustomerId=@item.PossibleDuplicateCustomerId" hx-target="#drawerBody">انتخاب رکورد دوم</a></div>}
else{<span class="badge badge--success"><span></span>ردشده</span>}
</td></tr>}</tbody></table></div></section>
