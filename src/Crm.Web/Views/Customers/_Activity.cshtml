@model Customer360Dto
<div id="customerActivity">
    <section class="customer-360-grid">
        <article class="panel"><div class="panel-heading"><div><strong>Timeline یکپارچه</strong><small>CRM و Projectionهای خارجی</small></div></div><div class="timeline-list">@if(Model.Timeline.Count == 0){<p class="empty-inline">رویدادی ثبت نشده است.</p>}@foreach(var item in Model.Timeline){<div><i></i><span><strong>@item.Title</strong><small>@item.Description</small><time>@item.OccurredAtUtc.ToString("yyyy/MM/dd HH:mm") · @item.Source</time></span></div>}</div></article>
        <article class="panel"><div class="panel-heading"><div><strong>ارتباطات تجاری</strong><small>داده مرتبط و مجاز در CRM</small></div></div><div class="relation-stats"><span><b>@Model.Leads.Count</b> سرنخ</span><span><b>@Model.Opportunities.Count</b> فرصت</span><span><b>@Model.Quotes.Count</b> پیشنهاد</span><span><b>@Model.Orders.Count</b> سفارش</span><span><b>@Model.DealerAffiliations.Count(x => x.IsActive)</b> نماینده</span><span><b>@Model.DuplicateCandidates.Count(x => x.Status == DuplicateReviewStatus.Pending)</b> مشابه در انتظار</span></div>@if(Model.Opportunities.Count > 0){<div class="record-list">@foreach(var item in Model.Opportunities.Take(4)){<div><span><strong>@item.Title</strong><small>@item.Code · @item.Stage</small></span><b>@($"{item.Value:N0}")</b></div>}</div>}@if(Model.Orders.Count > 0){<div class="record-list">@foreach(var item in Model.Orders.Take(4)){<div><span><strong>@item.Code — @item.Status</strong><small>پیشنهاد @item.QuoteCode · @(item.ErpOrderNumber ?? "در انتظار ERP")</small></span><a class="link-button" href="/orders/@item.Id">مشاهده</a></div>}</div>}@if(Model.DealerAffiliations.Count > 0){<div class="record-list">@foreach(var item in Model.DealerAffiliations.Take(3)){<div><span><strong>@item.DealerName</strong><small>@item.DealerCode · @(item.IsActive ? "فعال" : "پایان‌یافته")</small></span><a class="link-button" href="/dealers/@item.DealerId">پرونده نماینده</a></div>}</div>}</article>
    </section>
</div>
