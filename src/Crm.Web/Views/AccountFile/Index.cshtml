@model AccountFileDto
@{
    var a = Model.Account;
    ViewData["Title"] = $"پرونده حساب · {a.Name}";
    var c360 = ViewBag.Customer360 as Customer360Dto;
    var active = a.Status != CustomerStatus.Inactive;
    var basePath = $"/customers/{a.Id}";
}
<nav class="breadcrumb"><a href="/customers">مشتریان و حساب‌ها</a><svg><use href="#i-chevron"/></svg><span>@a.Name</span></nav>

<header class="account-head" data-account-id="@a.Id">
    <partial name="_AccountCard" model="AccountCardModel.From(a)" />
    <div class="account-head__bar">
        <div class="account-head__meta">
            <span class="badge badge--info">@AccountRecordService.RelationshipLabel(a.Relationship)</span>
            <span class="badge badge--neutral">@(a.Kind == CustomerKind.Legal ? "حقوقی" : "حقیقی")</span>
            <span><b>مالک:</b> @a.Owner</span>
            <span><b>شرکت:</b> @a.CompanyName</span>
            <span><b>شعبه:</b> @a.BranchName</span>
            @if (a.ParentId is { } parentId) { <span><b>حساب مادر:</b> <a href="/customers/@parentId">@a.ParentName</a></span> }
            @foreach (var tag in a.Tags) { <span class="chip">#@tag</span> }
        </div>
    <div class="account-head__actions">
        @if (Model.CanEdit)
        {
            <button class="button button--primary" type="button" hx-get="@basePath/edit" hx-target="#drawerBody"><svg><use href="#i-edit"/></svg>ویرایش حساب</button>
            <button class="button button--ghost" type="button" hx-get="@basePath/account/classify" hx-target="#drawerBody"><svg><use href="#i-target"/></svg>نوع رابطه و برچسب</button>
        }
        @if (Model.CanChangeStatus)
        {
            <button class="button button--ghost" type="button" hx-get="@basePath/account/status" hx-target="#drawerBody"><svg><use href="#i-shield"/></svg>@(active ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
        }
        <a class="button button--ghost" href="/customers"><svg><use href="#i-chevron"/></svg>بازگشت به فهرست</a>
    </div>
    </div>
</header>

@if (!active)
{
    <p class="account-banner account-banner--muted"><svg><use href="#i-info"/></svg>این حساب غیرفعال است: سوابق قابل مشاهده‌اند ولی ثبت فعالیت و رکورد جدید تا فعال‌سازی مجدد بسته است. حذف حساب دارای سابقه مجاز نیست؛ برای حساب تکراری از «ادغام» استفاده کنید.</p>
}

<section id="accountKpis" class="account-kpis" aria-label="شاخص‌های حساب" data-account-refresh hx-get="@basePath/file/kpis" hx-trigger="refresh" hx-swap="innerHTML">
    <partial name="_Kpis" model="Model" />
</section>

<div class="account-layout">
    <aside class="account-side" aria-label="فعالیت‌ها و عملیات">
        <section class="panel quick-panel">
            <div class="quick-panel__head"><strong>عملیات اصلی</strong><small>حساب جاری از پیش انتخاب شده است</small></div>
            <div class="quick-actions">
                <partial name="_QuickAction" model='new QuickActionModel("ایجاد فرصت", "i-target", $"{basePath}/quick/opportunity", Model.Quick.Opportunity, active)' />
                <partial name="_QuickAction" model='new QuickActionModel("برنامه‌ریزی تماس", "i-phone", $"{basePath}/activities/new/Call", Model.Quick.Call, active)' />
                <partial name="_QuickAction" model='new QuickActionModel("برنامه‌ریزی جلسه", "i-calendar", $"{basePath}/activities/new/Meeting", Model.Quick.Meeting, active)' />
                <partial name="_QuickAction" model='new QuickActionModel("ایجاد وظیفه", "i-task", $"{basePath}/activities/new/Task", Model.Quick.Task, active)' />
                <partial name="_QuickAction" model='new QuickActionModel("ایجاد یادداشت", "i-note", $"{basePath}/notes/new", Model.Quick.Note, active)' />
                <partial name="_QuickAction" model='new QuickActionModel("ایجاد سرنخ", "i-lead", $"{basePath}/quick/lead", Model.Quick.Lead, active)' />
            </div>
        </section>

        <section class="panel side-tabs" data-tabs="side">
            <div class="tabbar" role="tablist">
                <button type="button" role="tab" class="tabbar__tab is-active" data-tab="side-activities" aria-selected="true">فعالیت‌ها</button>
                <button type="button" role="tab" class="tabbar__tab" data-tab="side-notes" aria-selected="false">یادداشت‌ها</button>
            </div>
            <div data-tab-panel="side-activities">
                @if (Model.CanReadActivities)
                {
                    <div id="activityPanel" data-account-refresh hx-get="@basePath/activities@(ViewBag.Contact is Guid contactId ? $"?contact={contactId}" : "")" hx-trigger="load, refresh" hx-swap="innerHTML">
                        <p class="state-loading">در حال بارگذاری فعالیت‌ها…</p>
                    </div>
                }
                else { <p class="state-denied"><svg><use href="#i-shield"/></svg>مجوز مشاهدهٔ فعالیت‌ها را ندارید.</p> }
            </div>
            <div data-tab-panel="side-notes" hidden>
                @if (Model.CanReadNotes)
                {
                    <div id="notesPanel" data-account-refresh data-lazy hx-get="@basePath/notes" hx-trigger="refresh" hx-swap="innerHTML">
                        <p class="state-loading">در حال بارگذاری یادداشت‌ها…</p>
                    </div>
                }
                else { <p class="state-denied"><svg><use href="#i-shield"/></svg>مجوز مشاهدهٔ یادداشت‌ها را ندارید.</p> }
            </div>
        </section>
    </aside>

    <main class="account-main" data-tabs="main">
        <div class="tabbar tabbar--main" role="tablist">
            <button type="button" role="tab" class="tabbar__tab is-active" data-tab="overview" aria-selected="true">نمای کلی</button>
            <button type="button" role="tab" class="tabbar__tab" data-tab="activities" aria-selected="false">فعالیت‌ها و تعاملات</button>
            <button type="button" role="tab" class="tabbar__tab" data-tab="related" aria-selected="false">رکوردهای مرتبط <b class="tabbar__count">@Model.Sections.Sum(x => x.Count)</b></button>
            <button type="button" role="tab" class="tabbar__tab" data-tab="history" aria-selected="false">تاریخچه تغییرات</button>
        </div>

        <section data-tab-panel="overview">
            <partial name="_Overview" model="Model" view-data="ViewData" />
        </section>

        <section data-tab-panel="activities" hidden>
            <div class="panel timeline-panel">
                <div class="panel-heading"><div><strong>خط زمانی تعاملات</strong><small>فعالیت‌های انجام‌شده، یادداشت‌ها و رویدادهای فروش، مالی و خدمات؛ هر مورد یک بار</small></div></div>
                <div data-account-refresh data-lazy hx-get="@basePath/timeline" hx-trigger="refresh" hx-swap="innerHTML"><p class="state-loading">در حال بارگذاری…</p></div>
            </div>
        </section>

        <section data-tab-panel="related" hidden>
            <div class="related-tools panel">
                <label class="related-search"><svg><use href="#i-search"/></svg><input type="search" placeholder="جست‌وجوی بخش (مثلاً پرداخت، قرارداد، کمپین)" data-section-search aria-label="جست‌وجوی بخش‌ها" /></label>
                <div class="related-tools__buttons"><button type="button" class="link-button" data-sections-toggle="open">باز کردن همه</button><button type="button" class="link-button" data-sections-toggle="close">بستن همه</button></div>
            </div>
            <div id="sectionNav" data-account-refresh hx-get="@basePath/file/sections" hx-trigger="refresh" hx-swap="innerHTML">
                <partial name="_SectionNav" model="Model" />
            </div>
        </section>

        <section data-tab-panel="history" hidden>
            <div class="panel timeline-panel">
                <div class="panel-heading"><div><strong>تاریخچه تغییرات</strong><small>ایجاد، ویرایش، تغییر وضعیت، اتصال و قطع ارتباط با کاربر، تاریخ و ساعت</small></div></div>
                <div data-account-refresh data-lazy hx-get="@basePath/history" hx-trigger="refresh" hx-swap="innerHTML"><p class="state-loading">در حال بارگذاری…</p></div>
            </div>
        </section>
    </main>
</div>
