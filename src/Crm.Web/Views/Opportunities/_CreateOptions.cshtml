@{ var customers = ViewBag.Customers as IReadOnlyList<CustomerDto> ?? []; var owners = ViewBag.Owners as IReadOnlyList<SalesOwnerOptionDto> ?? []; var territories = ViewBag.Territories as IReadOnlyList<TerritoryOptionDto> ?? []; }
<label class="field"><span>مشتری *</span><select name="CustomerId" required>@if(customers.Count == 0){<option value="">مشتری فعالی در شعبه نیست</option>}@foreach(var item in customers){<option value="@item.Id">@item.Name — @item.Code</option>}</select></label><label class="field"><span>مالک *</span><select name="OwnerUserId" required>@foreach(var item in owners){<option value="@item.UserId" selected="@(ViewBag.SelectedOwnerId is Guid selected && selected == item.UserId)">@item.DisplayName — @item.RoleLabel</option>}</select></label><label class="field field--full"><span>قلمرو</span><select name="TerritoryId"><option value="">بدون قلمرو</option>@foreach(var item in territories){<option value="@item.Id">@item.Name — @item.Code</option>}</select></label>
