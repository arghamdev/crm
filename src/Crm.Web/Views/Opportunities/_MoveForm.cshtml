@model MoveOpportunityStageCommand
@{ var opportunity = (OpportunityDto)ViewBag.Opportunity; var canClose = ViewBag.CanClose == true; }
<form class="drawer-form" method="post" action="/opportunities/@opportunity.Id/move" hx-post="/opportunities/@opportunity.Id/move" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>تغییر مرحله @opportunity.Code</h3><div class="form-grid"><label class="field field--full"><span>مرحله مقصد *</span><select asp-for="TargetStage"><option value="Identified">شناسایی</option><option value="Discovery">کشف</option><option value="Qualified">تأیید</option><option value="SolutionOffer">ارائه راهکار</option><option value="Negotiation">مذاکره</option><option value="Commit">تعهد</option>@if(canClose){<option value="Won">برنده</option><option value="Lost">باخته</option>}</select></label><label class="field field--full"><span>دلیل/شاهد مرحله *</span><textarea asp-for="Reason" rows="4"></textarea></label></div></section><div class="identity-form-note">جابجایی مراحل باز تنها یک گام است؛ بستن Won/Lost نیازمند مجوز و دلیل نتیجه است.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت مرحله</button></div></form>
