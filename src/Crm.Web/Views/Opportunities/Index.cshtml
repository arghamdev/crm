@model PipelineBoardDto
@{ ViewData["Title"] = "فرصت‌های فروش"; }
<header class="page-header"><div><span class="eyebrow">Sales Pipeline · اولویت ۵</span><h1>فرصت‌های فروش</h1><p>قیف مرحله‌ای، ارزش وزنی، اقدام بعدی و کنترل فرصت‌های راکد</p></div><div class="page-actions"><a class="button button--primary" href="/opportunities/create" hx-get="/opportunities/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg> فرصت جدید</a></div></header>
@if (TempData["OpportunityError"] is string error) { <div class="validation-summary">@error</div> }
<section class="pipeline-summary"><div><small>ارزش کل</small><strong>@($"{Model.TotalValue / 1_000_000_000m:N1} میلیارد ریال")</strong></div><i></i><div><small>ارزش وزنی</small><strong>@($"{Model.WeightedValue / 1_000_000_000m:N1} میلیارد ریال")</strong></div><i></i><div><small>فرصت باز</small><strong>@Model.OpenCount</strong></div><i></i><div><small>راکد / اقدام عقب‌افتاده</small><strong>@Model.StalledCount / @Model.OverdueNextActionCount</strong></div></section>
<form id="pipelineFilters" class="panel toolbar pipeline-filter" method="get" action="/opportunities" hx-get="/opportunities/board" hx-target="#opportunityBoard" hx-trigger="submit, change delay:200ms"><label class="search-inline"><svg><use href="#i-search"/></svg><input name="q" value="@Model.Query" placeholder="عنوان، کد یا مشتری"/></label><label class="consent-row"><input name="includeClosed" type="checkbox" value="true" checked="@Model.IncludeClosed"/><span>نمایش برنده/باخته</span></label><button class="button button--ghost button--xs" type="submit">اعمال فیلتر</button><span class="muted">میانگین سن فعالیت: @Model.AverageAgeDays روز</span></form>
<div id="opportunityBoard" hx-get="/opportunities/board" hx-include="#pipelineFilters" hx-trigger="opportunityChanged from:body"><partial name="_Board" model="Model" /></div>
