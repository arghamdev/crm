@model CreateOpportunityCommand
@{ var branches = ViewBag.Branches as IReadOnlyList<OrganizationUnitOptionDto> ?? []; string Local(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); }
<form class="drawer-form" method="post" action="/opportunities/create" hx-post="/opportunities/create" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>فرصت جدید</h3><div class="form-grid"><label class="field field--full"><span>عنوان *</span><input asp-for="Title"/></label><label class="field"><span>شعبه *</span><select asp-for="BranchId" hx-get="/opportunities/create-options" hx-trigger="change" hx-target="#opportunityCreateOptions" hx-include="this">@foreach(var branch in branches){<option value="@branch.Id">@branch.Name — @branch.Code</option>}</select></label><label class="field"><span>ارزش (ریال) *</span><input asp-for="Value" type="number" min="1"/></label><div id="opportunityCreateOptions" class="form-grid form-grid--nested field--full"><partial name="_CreateOptions"/></div><label class="field"><span>منبع *</span><input asp-for="Source"/></label><label class="field"><span>رقیب</span><input asp-for="Competitor"/></label><label class="field"><span>ریسک</span><select asp-for="RiskLevel"><option value="Low">کم</option><option value="Medium">متوسط</option><option value="High">زیاد</option></select></label><label class="field"><span>تاریخ بستن *</span><input asp-for="ExpectedCloseAtUtc" type="datetime-local" value="@Local(Model.ExpectedCloseAtUtc)"/></label><label class="field"><span>اقدام بعدی *</span><input asp-for="NextAction"/></label><label class="field"><span>زمان اقدام *</span><input asp-for="NextActionAtUtc" type="datetime-local" value="@Local(Model.NextActionAtUtc)"/></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ایجاد فرصت</button></div></form>
