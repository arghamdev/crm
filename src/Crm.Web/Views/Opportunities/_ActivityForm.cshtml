@model AddOpportunityActivityCommand
@{ var opportunity = (OpportunityDto)ViewBag.Opportunity; string Local(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? ""; }
<form class="drawer-form" method="post" action="/opportunities/@opportunity.Id/activities/create" hx-post="/opportunities/@opportunity.Id/activities/create" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>فعالیت @opportunity.Code</h3><div class="form-grid"><label class="field"><span>نوع</span><select asp-for="Type"><option value="Call">تماس</option><option value="Meeting">جلسه</option><option value="Email">ایمیل</option><option value="Visit">بازدید</option><option value="Task">وظیفه</option><option value="Note">یادداشت</option></select></label><label class="field"><span>زمان وقوع *</span><input asp-for="OccurredAtUtc" type="datetime-local" value="@Local(Model.OccurredAtUtc)"/></label><label class="field field--full"><span>موضوع *</span><input asp-for="Subject"/></label><label class="field field--full"><span>نتیجه *</span><textarea asp-for="Outcome" rows="3"></textarea></label><label class="field"><span>اقدام بعدی</span><input asp-for="NextAction"/></label><label class="field"><span>زمان اقدام بعدی</span><input asp-for="NextActionAtUtc" type="datetime-local" value="@Local(Model.NextActionAtUtc)"/></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت فعالیت</button></div></form>
