@model AssignOpportunityCommand
@{ var opportunity = (OpportunityDto)ViewBag.Opportunity; var owners = ViewBag.Owners as IReadOnlyList<SalesOwnerOptionDto> ?? []; }
<form class="drawer-form" method="post" action="/opportunities/@opportunity.Id/assign" hx-post="/opportunities/@opportunity.Id/assign" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>تخصیص @opportunity.Code</h3><div class="form-grid"><label class="field field--full"><span>مالک جدید *</span><select asp-for="OwnerUserId">@foreach(var owner in owners){<option value="@owner.UserId">@owner.DisplayName — @owner.RoleLabel</option>}</select></label><label class="field field--full"><span>دلیل *</span><textarea asp-for="Reason" rows="3"></textarea></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ثبت تخصیص</button></div></form>
