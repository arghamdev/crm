@model UpdateOpportunityCommand
@{ var opportunity = (OpportunityDto)ViewBag.Opportunity; string Local(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); }
<form class="drawer-form" method="post" action="/opportunities/@opportunity.Id/edit" hx-post="/opportunities/@opportunity.Id/edit" hx-target="#drawerBody" hx-swap="innerHTML">@Html.AntiForgeryToken()<input asp-for="ExpectedVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><h3>ویرایش @opportunity.Code</h3><div class="form-grid"><label class="field field--full"><span>عنوان *</span><input asp-for="Title"/></label><label class="field"><span>ارزش (ریال) *</span><input asp-for="Value" type="number" min="1"/></label><label class="field"><span>بستن مورد انتظار *</span><input asp-for="ExpectedCloseAtUtc" type="datetime-local" value="@Local(Model.ExpectedCloseAtUtc)"/></label><label class="field"><span>منبع *</span><input asp-for="Source"/></label><label class="field"><span>رقیب</span><input asp-for="Competitor"/></label><label class="field"><span>ریسک</span><select asp-for="RiskLevel"><option value="Low">کم</option><option value="Medium">متوسط</option><option value="High">زیاد</option></select></label><label class="field"><span>اقدام بعدی *</span><input asp-for="NextAction"/></label><label class="field"><span>زمان اقدام *</span><input asp-for="NextActionAtUtc" type="datetime-local" value="@Local(Model.NextActionAtUtc)"/></label></div></section><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">ذخیره</button></div></form>
