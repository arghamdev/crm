@model OpportunityDetailsDto
@{ ViewData["Title"] = "جزئیات فرصت"; var opportunity = Model.Opportunity; }
@functions { private static string StageText(OpportunityStage value) => value switch { OpportunityStage.Identified => "شناسایی", OpportunityStage.Discovery => "کشف", OpportunityStage.Qualified => "تأیید", OpportunityStage.SolutionOffer => "ارائه راهکار", OpportunityStage.Negotiation => "مذاکره", OpportunityStage.Commit => "تعهد", OpportunityStage.Won => "برنده", _ => "باخته" }; }
<nav class="breadcrumb"><a href="/opportunities">فرصت‌ها</a><svg><use href="#i-chevron"/></svg><span>@opportunity.Code</span></nav>
<section class="customer-hero"><div class="customer-hero__identity"><span class="entity-avatar">@opportunity.Customer[..1]</span><div><div class="title-line"><h1>@opportunity.Title</h1><span class="badge @(opportunity.Stage == OpportunityStage.Won ? "badge--success" : opportunity.Stage == OpportunityStage.Lost ? "badge--danger" : "badge--info")"><span></span>@StageText(opportunity.Stage)</span></div><p>@opportunity.Code · @opportunity.Customer · احتمال @opportunity.Probability٪</p><div class="contact-line"><span>مالک: @opportunity.Owner</span><i></i><span>@opportunity.BranchId / @(opportunity.TerritoryId ?? "*")</span><i></i><span>نسخه @opportunity.Version</span></div></div></div><div class="page-actions">@if(Model.CanUpdate){<a class="button button--ghost" href="/opportunities/@opportunity.Id/edit" hx-get="/opportunities/@opportunity.Id/edit" hx-target="#drawerBody">ویرایش</a><a class="button button--ghost" href="/opportunities/@opportunity.Id/activities/create" hx-get="/opportunities/@opportunity.Id/activities/create" hx-target="#drawerBody">ثبت فعالیت</a>@if(opportunity.Stage != OpportunityStage.Commit || Model.CanClose){<a class="button button--primary" href="/opportunities/@opportunity.Id/move" hx-get="/opportunities/@opportunity.Id/move" hx-target="#drawerBody">تغییر مرحله</a>}}@if(Model.CanAssign){<a class="button button--ghost" href="/opportunities/@opportunity.Id/assign" hx-get="/opportunities/@opportunity.Id/assign" hx-target="#drawerBody">تخصیص</a>}</div></section>
<section class="customer-kpis"><article><small>ارزش فرصت</small><strong>@($"{opportunity.Value:N0} ریال")</strong><span>وزنی: @($"{opportunity.Value * opportunity.Probability / 100m:N0}")</span></article><article><small>بستن مورد انتظار</small><strong>@opportunity.ExpectedCloseAtUtc?.ToLocalTime().ToString("yyyy/MM/dd")</strong><span>@opportunity.Source</span></article><article><small>اقدام بعدی</small><strong>@(opportunity.NextAction ?? "—")</strong><span>@(opportunity.NextActionAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "بدون زمان")</span></article><article><small>ریسک / رقیب</small><strong>@opportunity.RiskLevel</strong><span>@(opportunity.Competitor ?? "بدون رقیب ثبت‌شده")</span></article></section>
<section class="customer-360-grid"><article class="panel"><div class="panel-heading"><div><strong>تاریخچه مرحله</strong><small>احتمال و دلیل هر تغییر</small></div></div><div class="audit-list">@if(Model.StageHistory.Count == 0){<p class="empty-inline">تاریخچه‌ای ثبت نشده است.</p>}@foreach(var item in Model.StageHistory){<div><strong>@(item.FromStage?.ToString() ?? "ایجاد") ← @StageText(item.ToStage) · @item.Probability٪</strong><span>@item.ChangedByName · @item.ChangedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span><small>@item.Reason</small></div>}</div></article><article class="panel"><div class="panel-heading"><div><strong>فعالیت‌ها</strong><small>تعامل و اقدام بعدی</small></div></div><div class="audit-list">@if(Model.Activities.Count == 0){<p class="empty-inline">فعالیتی ثبت نشده است.</p>}@foreach(var item in Model.Activities){<div><strong>@item.Type · @item.Subject</strong><span>@item.ActorName · @item.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span><small>@item.Outcome @if(item.NextAction is not null){<text>— بعدی: @item.NextAction</text>}</small></div>}</div></article></section>
@if(opportunity.Stage is OpportunityStage.Won or OpportunityStage.Lost){<section class="panel quality-panel"><div class="panel-heading"><div><strong>نتیجه نهایی</strong><small>@opportunity.ClosedAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></div></div><p>@opportunity.OutcomeReason</p></section>}
