@model FollowUpWaitModel
@{
    var c = Model.Case;
    var w = Model.Wait;
    var r = Model.Resume;
    var waitAction = $"/follow-ups/{c.Id}/wait";
    var resumeAction = $"/follow-ups/{c.Id}/resume";
}
<div class="drawer-form" data-fu-tabs>
    <span data-drawer-title hidden>انتظار و ازسرگیری</span>
    <partial name="_CaseContext" model="c" />
    <div class="tabbar" role="tablist">
        <button type="button" role="tab" class="tabbar__tab@(Model.Tab == "wait" ? " is-active" : "")" data-fu-tab="wait" disabled="@c.IsWaiting">ثبت انتظار</button>
        <button type="button" role="tab" class="tabbar__tab@(Model.Tab == "resume" ? " is-active" : "")" data-fu-tab="resume" disabled="@(!c.IsWaiting)">ازسرگیری</button>
    </div>
    <form data-fu-panel="wait" hidden="@(Model.Tab != "wait")" class="drawer-form" method="post" action="@waitAction" hx-post="@waitAction" hx-target="#drawerBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <section class="form-section">
            <h3>وضعیت انتظار</h3>
            <div class="form-grid">
                <label><span>وضعیت جدید *</span><select name="Status">
                    <option value="WaitingCustomer" selected="@(w.Status == FollowUpStatus.WaitingCustomer)">در انتظار مشتری</option>
                    <option value="WaitingInternal" selected="@(w.Status == FollowUpStatus.WaitingInternal)">در انتظار واحد داخلی / تأمین‌کننده</option>
                    <option value="OnHold" selected="@(w.Status == FollowUpStatus.OnHold)">متوقف (با علت و موعد بازبینی)</option>
                </select></label>
                <label><span>مرحلهٔ مرتبط</span><select name="StageId"><option value="">— کل پرونده —</option>@foreach (var s in c.Stages.Where(x => x.Status is FollowUpStageStatus.Active or FollowUpStageStatus.Returned)) { <option value="@s.Id" selected="@(w.StageId == s.Id)">@s.Name</option> }</select></label>
                <label class="field--full"><span>علت انتظار *</span><textarea name="Reason" rows="3" required maxlength="500" placeholder="مثلاً مشتری باید نقشهٔ فنی را ارسال کند">@w.Reason</textarea></label>
                <label class="field--full"><span>منتظر پاسخ از</span><input name="WaitingOn" value="@w.WaitingOn" maxlength="120" placeholder="شخص یا واحد" /></label>
                <label><span>تاریخ درخواست</span><input name="RequestedDate" value="@w.RequestedDate" inputmode="numeric" data-jalali /></label>
                <label><span>پاسخ مورد انتظار تا</span><input name="ExpectedDate" value="@w.ExpectedDate" inputmode="numeric" data-jalali /></label>
                <label><span>ساعت</span><input name="ExpectedTime" value="@w.ExpectedTime" dir="ltr" inputmode="numeric" /></label>
                <label><span>موعد بازبینی *</span><input name="ReviewDate" value="@w.ReviewDate" required inputmode="numeric" data-jalali /></label>
                <label><span>ساعت بازبینی</span><input name="ReviewTime" value="@w.ReviewTime" dir="ltr" inputmode="numeric" /></label>
                <label><span>مسئول بازبینی *</span><select name="ReviewOwnerUserId">@foreach (var u in c.Users) { <option value="@u.Value" selected="@(w.ReviewOwnerUserId.ToString() == u.Value)">@u.Label</option> }</select></label>
            </div>
        </section>
        <section class="form-section fu-effect">
            <h3>اثر بر مهلت</h3>
            <ul>
                <li><span class="pill pill--sm pill--@(c.PausesOnCustomer ? "success" : "neutral")">@(c.PausesOnCustomer ? "توقف" : "ادامه")</span> در انتظار مشتری</li>
                <li><span class="pill pill--sm pill--@(c.PausesOnInternal ? "success" : "neutral")">@(c.PausesOnInternal ? "توقف" : "ادامه")</span> در انتظار واحد داخلی / تأمین‌کننده</li>
                <li><span class="pill pill--sm pill--neutral">ادامه</span> متوقف</li>
            </ul>
            <small class="field-help">طبق سیاست «@c.SlaPolicy». موعد بازبینی، اقدام بعدی پرونده می‌شود. پس از ازسرگیری، زمان توقف به مهلت‌ها افزوده می‌شود.</small>
        </section>
        <div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit"><svg><use href="#i-pause"/></svg>ثبت وضعیت انتظار</button></div>
    </form>
    <form data-fu-panel="resume" hidden="@(Model.Tab != "resume")" class="drawer-form" method="post" action="@resumeAction" hx-post="@resumeAction" hx-target="#drawerBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        @if (c.IsWaiting)
        {
            <section class="form-section">
                <h3>انتظار فعلی</h3>
                <dl class="fu-facts">
                    <div><dt>وضعیت</dt><dd>@FollowUpLabels.Status(c.Status)</dd></div>
                    <div><dt>علت</dt><dd>@c.WaitReason</dd></div>
                    <div><dt>منتظر</dt><dd>@(c.WaitingOn ?? "—")</dd></div>
                    <div><dt>مهلت</dt><dd>@(c.IsPaused ? "متوقف" : "در جریان")</dd></div>
                </dl>
            </section>
        }
        <section class="form-section">
            <h3>ادامهٔ کار</h3>
            <div class="form-grid">
                <label class="field--full"><span>توضیح</span><input name="Note" value="@r.Note" maxlength="300" placeholder="مثلاً نقشه دریافت شد" /></label>
                <label class="field--full"><span>اقدام بعدی *</span><input name="NextTitle" value="@r.NextTitle" required maxlength="200" /></label>
                <label><span>تاریخ *</span><input name="NextDate" value="@r.NextDate" required inputmode="numeric" data-jalali /></label>
                <label><span>ساعت</span><input name="NextTime" value="@r.NextTime" dir="ltr" inputmode="numeric" /></label>
            </div>
        </section>
        <div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit"><svg><use href="#i-play"/></svg>ازسرگیری پرونده</button></div>
    </form>
</div>
