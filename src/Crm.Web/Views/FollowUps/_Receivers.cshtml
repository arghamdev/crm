@model IReadOnlyList<AssignmentCandidateDto>
@{
    // The first eligible person with free capacity is preselected; the green card shows the chosen receiver's capacity.
    var pick = Model.FirstOrDefault(x => x.Eligible && x.Available && (x.Capacity == 0 || x.Load < x.Capacity)) ?? Model.FirstOrDefault(x => x.Available);
}
<span class="fu-f__c" id="fuReceivers"><svg><use href="#i-user"/></svg><select name="ToUserId" required data-receivers aria-label="گیرنده">
    <option value="">@(Model.Count == 0 ? "در این شعبه کاربر فعالی نیست" : "— انتخاب گیرنده —")</option>
    @foreach (var r in Model)
    {
        var full = r.Capacity > 0 && r.Load >= r.Capacity;
        <option value="@r.UserId" selected="@(pick?.UserId == r.UserId)" data-name="@r.Name" data-initial="@ListFormat.Initial(r.Name)" data-load="@r.Load" data-capacity="@r.Capacity"
                data-available="@(r.Available ? "true" : "false")" data-note="@r.Note">@r.Name — @(!r.Available ? "خارج از دسترس" : full ? "ظرفیت تکمیل" : r.Capacity > 0 ? $"{FollowUpLabels.Fa(r.Load)} از {FollowUpLabels.Fa(r.Capacity)}" : "آماده")</option>
    }
</select></span>
