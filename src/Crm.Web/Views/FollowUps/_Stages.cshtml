@model FollowUpCaseDto
@{
    var c = Model;
    var basePath = $"/follow-ups/{c.Id}";
    var active = c.ActiveStage;
    var now = DateTimeOffset.UtcNow;
    static string StateClass(FollowUpStageStatus s) => s switch
    {
        FollowUpStageStatus.Done => "done", FollowUpStageStatus.Active => "active", FollowUpStageStatus.Waiting => "waiting",
        FollowUpStageStatus.Returned => "returned", FollowUpStageStatus.Skipped => "skipped", _ => "pending"
    };
    static string StateIcon(FollowUpStageStatus s) => s switch
    {
        FollowUpStageStatus.Done => "i-check", FollowUpStageStatus.Active => "i-more", FollowUpStageStatus.Waiting => "i-pause",
        FollowUpStageStatus.Returned => "i-sort", FollowUpStageStatus.Skipped => "i-ban", _ => "i-clock"
    };
}
<section class="panel fu-stagecard" aria-labelledby="fuStagesTitle">
    <div class="fu-stagecard__head"><partial name="_SheetHead" model="@(FollowUpSheetHead.ForCase(5, "مراحل و وظایف پرونده", c))" /></div>
    <div class="fu-stagecard__top">
        <div class="fu-stagecard__total">
            <div><span class="fu-total-label">پیشرفت کل</span><b class="fu-total">@FollowUpLabels.Fa(c.Progress)٪</b><small>@FollowUpLabels.Words(c.Progress) درصد</small></div>
            <div class="fu-progressbar" role="progressbar" aria-valuenow="@c.Progress" aria-valuemin="0" aria-valuemax="100" aria-label="پیشرفت وزنی پرونده"><span style="width:@c.Progress%"></span></div>
        </div>
        <div class="fu-person"><span class="fu-avatar">@ListFormat.Initial(c.Owner ?? "—")</span><span><small>مسئول پرونده</small><strong>@(c.Owner ?? "بدون مسئول")</strong></span></div>
    </div>
    <div class="table-wrap">
        <table class="fu-t fu-stage-table">
            <thead><tr><th>مرحله</th><th>وزن</th><th>پیشرفت</th><th>وضعیت</th></tr></thead>
            <tbody>
                @foreach (var s in c.Stages)
                {
                    <tr class="@(s.Id == active?.Id ? "is-current" : "")" title="@(s.Responsible ?? "—")@(s.DueAtUtc is { } d0 ? " · مهلت " + FollowUpLabels.When(d0, now) : "")">
                        <td><span class="fu-stage-name"><span class="fu-stage-ico"><svg><use href="#@FollowUpLabels.StageIcon(s.Name)"/></svg></span><span>@s.Name<small>@s.ResponsibleRole@(s.Required ? "" : " · اختیاری")@if (s.Condition is not null) { <text> · شرط: @s.Condition</text> }</small>@if (s.ReturnReason is not null && s.Status == FollowUpStageStatus.Returned) { <small class="cell-flag"><svg><use href="#i-sort"/></svg>@s.ReturnReason</small> }@if (s.SkipReason is not null) { <small>کنار گذاشته: @s.SkipReason</small> }</span></span></td>
                        <td>@FollowUpLabels.Fa(s.Weight)٪</td>
                        <td><span class="fu-progress" style="--value:@s.Progress"><span></span><b>@FollowUpLabels.Fa(s.Progress)٪</b></span></td>
                        <td><span class="fu-state fu-state--@StateClass(s.Status)" title="@FollowUpLabels.Stage(s.Status)"><svg><use href="#@StateIcon(s.Status)"/></svg></span><span class="sr-only">@FollowUpLabels.Stage(s.Status)</span></td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (active is null)
    {
        <p class="fu-note"><svg><use href="#i-info"/></svg><span>@(c.IsOpen ? c.Status == FollowUpStatus.ResolvedPendingApproval ? "همهٔ مراحل انجام شد؛ پرونده آمادهٔ بستن است." : "مرحلهٔ فعالی وجود ندارد." : "پرونده بسته است.")</span></p>
    }
    else
    {
        var total = active.Checklist.Count;
        var doneCount = active.Checklist.Count(x => x.IsDone);
        var remaining = total - doneCount;
        var stagePercent = total == 0 ? active.Progress : (int)Math.Round(doneCount * 100.0 / total);
        var editable = c.IsOpen && c.CanUpdate;
        var docs = c.Documents.Where(x => x.StageName == active.Name).ToList();
        <form class="fu-active fu-checklist" method="post" action="@basePath/stages/@active.Id/checklist" hx-post="@basePath/stages/@active.Id/checklist" hx-swap="none" data-checklist data-blocked="@(c.Approvals.Any(x => x.Decision is null && x.StageName == active.Name) ? "approval" : null)">
            @Html.AntiForgeryToken()
            <h3 class="fu-sec__h"><svg><use href="#i-clipboard"/></svg>چک‌لیست مرحله فعال<small class="fu-f__hint">@active.Name</small></h3>
            <div class="fu-g">
                <div class="fu-person"><span class="fu-avatar">@ListFormat.Initial(active.Responsible ?? "—")</span><span><small>مسئول مرحله</small><strong>@(active.Responsible ?? "—")</strong></span></div>
                <div class="fu-person"><span class="fu-avatar"><svg><use href="#i-clock"/></svg></span><span><small>مهلت مرحله</small><strong class="@(active.IsOverdue ? "text-danger" : "")">@FollowUpLabels.When(active.DueAtUtc, now)</strong></span></div>
            </div>
            <div class="fu-ready">
                <div class="fu-stage-progress"><span>پیشرفت مرحله : @FollowUpLabels.Fa(stagePercent)٪</span><div class="fu-progressbar"><span style="width:@stagePercent%"></span></div><b>@FollowUpLabels.Fa(doneCount) از @FollowUpLabels.Fa(total) مورد تکمیل شده</b></div>
            </div>
            <fieldset disabled="@(!editable)">
                <legend class="sr-only">وظایف این مرحله</legend>
                @foreach (var item in active.Checklist)
                {
                    <label class="fu-check@(item.IsDone ? " is-done" : "")"><input type="checkbox" name="done" value="@item.Id" checked="@item.IsDone" /><span>@item.Title</span>@if (item.IsDone) { <small>@item.DoneBy · @(item.DoneAtUtc is { } at ? FollowUpLabels.When(at, now) : "")</small> }</label>
                }
                @if (active.Checklist.Count == 0) { <p class="empty-mini">این مرحله چک‌لیست ندارد؛ تکمیل آن با تأیید مسئول انجام می‌شود.</p> }
            </fieldset>
            <div class="fu-active__docs">
                <span><svg><use href="#i-clip"/></svg>مستندات مرتبط</span>
                @foreach (var doc in docs) { <a class="fu-file" href="@basePath/documents/@doc.Id"><svg><use href="#i-file"/></svg><span>@doc.Title</span><small>نسخهٔ @FollowUpLabels.Fa(doc.Version) · @FollowUpLabels.DocumentStatus(doc.Status)</small></a> }
                @if (docs.Count == 0) { <small class="fu-f__hint">مدرکی برای این مرحله ثبت نشده است.</small> }
                @if (editable) { <button class="fu-add" type="button" hx-get="@basePath/documents" hx-target="#modalBody" hx-swap="innerHTML" hx-disabled-elt="this"><svg><use href="#i-plus"/></svg>افزودن مدرک</button> }
            </div>
            @if (remaining > 0) { <p class="fu-note fu-note--amber" data-checklist-warning><svg><use href="#i-alert"/></svg><span>برای تکمیل مرحله، <b data-checklist-remaining data-words>@FollowUpLabels.Words(remaining)</b> مورد باقی‌مانده انجام شود.</span></p> }
            @if (active.CompleteBlockedReason is { } reason && remaining == 0) { <p class="fu-note fu-note--amber"><svg><use href="#i-lock"/></svg><span>@reason</span></p> }
            @if (editable)
            {
                <div class="fu-inline-actions fu-halves">
                    <button class="button button--primary" type="submit"><svg><use href="#i-save"/></svg>ذخیره وضعیت وظایف</button>
                    <button class="button button--plain" type="submit" name="complete" value="true" data-complete disabled="@(remaining > 0 || (active.CompleteBlockedReason is not null && remaining == 0))"><svg><use href="#i-lock"/></svg>تکمیل مرحله</button>
                </div>
            }
        </form>
    }

    @if (c.IsOpen && c.CanUpdate && (active is not null || c.Rules.Count > 0))
    {
        <details class="fu-more-fields">
            <summary><svg><use href="#i-chevron"/></svg>اقدام‌های مرحله و قواعد الگو</summary>
            <div class="fu-sheet__body">
                @if (active is not null)
                {
                    <div class="fu-stage-actions">
                        <button class="link-button" type="button" hx-get="@basePath/plan?stageId=@active.Id" hx-target="#modalBody" hx-swap="innerHTML"><svg><use href="#i-calendar"/></svg>اقدام برای این مرحله</button>
                        <button class="link-button" type="button" hx-get="@basePath/refer?scope=Stage" hx-target="#modalBody" hx-swap="innerHTML"><svg><use href="#i-send"/></svg>ارجاع مرحله</button>
                        <button class="link-button" type="button" hx-get="@basePath/documents?tab=request" hx-target="#modalBody" hx-swap="innerHTML"><svg><use href="#i-shield"/></svg>درخواست تأیید</button>
                        @if (c.CanAssign && !active.Required)
                        {
                            <form method="post" action="@basePath/stages/@active.Id/skip" hx-post="@basePath/stages/@active.Id/skip" hx-swap="none" data-prompt="دلیل کنار گذاشتن مرحله (شرط برقرار نیست)">@Html.AntiForgeryToken()<button class="link-button" type="submit"><svg><use href="#i-close"/></svg>کنار گذاشتن مرحله</button></form>
                        }
                    </div>
                    @if (c.CanAssign)
                    {
                        <form class="fu-assign" method="post" action="@basePath/stages/@active.Id/assign" hx-post="@basePath/stages/@active.Id/assign" hx-swap="none">
                            @Html.AntiForgeryToken()
                            <label><span>مسئول مرحله</span><select name="responsibleUserId">@foreach (var u in c.Users) { <option value="@u.Value" selected="@(active.ResponsibleUserId?.ToString() == u.Value)">@u.Label</option> }</select></label>
                            <button class="button button--ghost button--sm" type="submit">تعیین</button>
                        </form>
                    }
                }
                @if (c.Rules.Count > 0)
                {
                    <div class="fu-rules">
                        <strong><svg><use href="#i-flow"/></svg>قواعد الگو</strong>
                        @foreach (var rule in c.Rules)
                        {
                            <form method="post" action="@basePath/rules/@rule.Index" hx-post="@basePath/rules/@rule.Index" hx-swap="none" data-confirm="«@rule.Condition» رخ داده است؟ اقدام: @rule.Action">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="chip-action"><span>اگر <b>@rule.Condition</b></span><svg><use href="#i-chevron"/></svg><span>@rule.Action</span></button>
                            </form>
                        }
                    </div>
                }
            </div>
        </details>
    }
</section>
