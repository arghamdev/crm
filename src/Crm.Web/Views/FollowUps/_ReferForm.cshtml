@model FollowUpReferModel
@{
    var c = Model.Case;
    var cmd = Model.Command;
    var action = $"/follow-ups/{c.Id}/refer";
    var stage = c.ActiveStage;
    var received = Model.Inbox;
    var pending = received.Count(x => x.Status == ReferralStatus.Pending);
    var presets = FollowUpsController.AcceptPresets(DateTimeOffset.UtcNow);
    var preset = presets.FirstOrDefault(x => x.Date == cmd.AcceptDate && x.Time == cmd.AcceptTime).Key ?? "custom";
}
<div class="fu-sheet" data-fu-tabs>
    <partial name="_SheetHead" model="@(FollowUpSheetHead.ForCase(4, "ارجاع و پذیرش مسئولیت", c, twoLine: true, icon: "i-case"))" />
    <div class="fu-sheet__body fu-sheet__body--tabs">
        <div class="fu-utabs" role="tablist">
            <button type="button" role="tab" class="@(Model.Tab != "received" ? "is-active" : "")" data-fu-tab="new">ارجاع جدید</button>
            <button type="button" role="tab" class="@(Model.Tab == "received" ? "is-active" : "")" data-fu-tab="received">ارجاع‌های دریافتی @if (pending > 0) { <b>@FollowUpLabels.Fa(pending)</b> }</button>
        </div>
    </div>
    <form data-fu-panel="new" hidden="@(Model.Tab == "received")" method="post" action="@action" hx-post="@action" hx-target="#modalBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
        <div class="fu-sheet__body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StageId" value="@stage?.Id" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <fieldset class="fu-radios">
                <legend>محدودهٔ ارجاع<i class="fu-req">*</i></legend>
                <label><input type="radio" name="Scope" value="Stage" checked="@(cmd.Scope == ReferralScope.Stage)" disabled="@(stage is null)" /><span>اجرای مرحله@(stage is null ? " (مرحلهٔ فعالی نیست)" : $" «{stage.Name}»")</span></label>
                <label><input type="radio" name="Scope" value="Case" checked="@(cmd.Scope == ReferralScope.Case)" /><span>کل پرونده (مسئولیت نهایی منتقل می‌شود)</span></label>
            </fieldset>
            <section class="fu-box fu-box--blue">
                <div class="fu-g">
                    <div class="fu-person"><span class="fu-avatar">@ListFormat.Initial(c.Owner ?? "—")</span><span><small>مسئول پرونده</small><strong>@(c.Owner ?? "بدون مسئول")</strong></span></div>
                    <div class="fu-person"><span class="fu-avatar">@ListFormat.Initial(stage?.Responsible ?? "—")</span><span><small>مسئول فعلی مرحله@(stage is null ? "" : $" «{stage.Name}»")</small><strong>@(stage?.Responsible ?? "—")</strong></span></div>
                </div>
            </section>
            <div class="fu-g">
                <label class="fu-f"><span class="fu-f__l">شعبهٔ مقصد<i>*</i></span><span class="fu-f__c"><svg><use href="#i-pin"/></svg><select name="ToBranchId" required hx-disabled-elt="this" hx-get="/follow-ups/@c.Id/refer/receivers" hx-target="#fuReceivers" hx-swap="outerHTML" hx-trigger="change">@foreach (var b in c.Branches) { <option value="@b.Value" selected="@(string.Equals(cmd.ToBranchId, b.Value, StringComparison.OrdinalIgnoreCase))">@b.Label</option> }</select></span></label>
                <label class="fu-f"><span class="fu-f__l">تیم مقصد<i>*</i></span><span class="fu-f__c"><svg><use href="#i-users"/></svg><select name="ToTeam" required>
                    <option value="">— انتخاب تیم —</option>
                    @foreach (var t in c.Teams) { <option value="@t.Label" selected="@(cmd.ToTeam == t.Label)">@t.Label</option> }
                    @foreach (var t in new[] { "تیم فنی", "تأمین و انبار", "مالی" }.Where(x => c.Teams.All(y => y.Label != x))) { <option value="@t" selected="@(cmd.ToTeam == t)">@t</option> }
                </select></span></label>
                <label class="fu-f"><span class="fu-f__l">گیرنده<i>*</i></span><partial name="_Receivers" model="Model.Receivers" /></label>
                <label class="fu-f"><span class="fu-f__l">مهلت پذیرش<i>*</i></span><span class="fu-f__c"><svg><use href="#i-clock"/></svg><select name="acceptPreset" data-switch="accept">
                    @foreach (var p in presets) { <option value="@p.Key" selected="@(preset == p.Key)">@p.Label</option> }
                    <option value="custom" selected="@(preset == "custom")">تاریخ و ساعت دلخواه…</option>
                </select></span></label>
                <div class="fu-g fu-span" data-switch-for="accept" data-when="custom" hidden="@(preset != "custom")">
                    <label class="fu-f"><span class="fu-f__l">تاریخ پذیرش</span><span class="fu-f__c"><svg><use href="#i-calendar"/></svg><input name="AcceptDate" value="@cmd.AcceptDate" inputmode="numeric" data-jalali /></span></label>
                    <label class="fu-f"><span class="fu-f__l">ساعت</span><span class="fu-f__c"><svg><use href="#i-clock"/></svg><input name="AcceptTime" value="@cmd.AcceptTime" dir="ltr" inputmode="numeric" /></span></label>
                </div>
            </div>
            <section class="fu-box fu-box--green" data-capacity-card hidden>
                <div class="fu-capacity">
                    <span class="fu-avatar" data-capacity-initial hidden></span>
                    <div>
                        <strong><span data-capacity-name></span> <span class="fu-cap-pill" data-capacity-state>آماده دریافت</span></strong>
                        <small data-capacity-load></small>
                        <div class="fu-progressbar" hidden><span data-capacity-bar></span></div>
                    </div>
                    <span class="fu-cap-dot" aria-hidden="true"></span>
                </div>
            </section>
            <label class="fu-f"><span class="fu-f__l">دلیل ارجاع<i>*</i></span><span class="fu-f__c"><svg class="fu-f__ta-icon"><use href="#i-note"/></svg><textarea name="Reason" rows="3" required maxlength="500" placeholder="چرا این کار باید به گیرنده سپرده شود؟">@cmd.Reason</textarea></span></label>
            <fieldset class="fu-checks-inline fu-checks-box">
                <legend>اطلاعات همراه ارجاع</legend>
                <label><input type="checkbox" name="IncludeHistory" value="true" checked="@cmd.IncludeHistory" /><span>سوابق تعاملات</span></label>
                <label><input type="checkbox" name="IncludeQuote" value="true" checked="@cmd.IncludeQuote" /><span>پیش‌فاکتور</span></label>
                <label><input type="checkbox" name="IncludeTechnical" value="true" checked="@cmd.IncludeTechnical" /><span>مدارک فنی</span></label>
            </fieldset>
            <p class="fu-note fu-note--amber"><svg><use href="#i-alert"/></svg><span>تا پذیرش گیرنده، مسئول فعلی پاسخ‌گو می‌ماند. اگر ارجاع در مهلت پذیرفته نشود، سرپرست مطلع می‌شود.</span></p>
            <p class="fu-note fu-note--plain"><svg><use href="#i-info"/></svg><span>پذیرش یا رد با دلیل در تاریخچه ثبت می‌شود.</span></p>
        </div>
        <footer class="fu-sheet__foot">
            <button class="button button--primary" type="submit"><svg><use href="#i-send"/></svg>ثبت و ارسال ارجاع</button>
            <button class="button button--plain fu-foot__end" type="button" data-drawer-close>انصراف</button>
        </footer>
    </form>
    <section data-fu-panel="received" hidden="@(Model.Tab != "received")">
        <div class="fu-sheet__body">
            @if (received.Count == 0) { <p class="empty-mini">ارجاعی برای شما ثبت نشده است.</p> }
            <ul class="fu-inbox__list fu-inbox__list--sheet">
                @foreach (var r in received)
                {
                    <li class="@(r.IsLate ? "is-late" : "")">
                        <a href="/follow-ups/@r.CaseId"><bdi>@r.CaseCode</bdi> · @r.CaseSubject</a>
                        <small>@r.CustomerName · از @r.From · @(r.Scope == ReferralScope.Case ? "کل پرونده" : $"مرحلهٔ «{r.StageName}»") · مهلت پذیرش: @FollowUpLabels.When(r.AcceptDueAtUtc, DateTimeOffset.UtcNow)</small>
                        <p>@r.Reason</p>
                        <span class="pill pill--sm pill--@FollowUpLabels.ReferralTone(r.Status)">@FollowUpLabels.Referral(r.Status)</span>
                        @if (r.CanRespond)
                        {
                            <div class="fu-inbox__actions">
                                <form method="post" action="/follow-ups/referrals/@r.Id/accept" hx-post="/follow-ups/referrals/@r.Id/accept" hx-swap="none">@Html.AntiForgeryToken()<button class="button button--primary button--sm" type="submit"><svg><use href="#i-check"/></svg>پذیرش</button></form>
                                <form method="post" action="/follow-ups/referrals/@r.Id/reject" hx-post="/follow-ups/referrals/@r.Id/reject" hx-swap="none" data-prompt="دلیل رد ارجاع">@Html.AntiForgeryToken()<button class="button button--ghost button--sm" type="submit">رد با دلیل</button></form>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
        <footer class="fu-sheet__foot"><button class="button button--ghost fu-foot__end" type="button" data-drawer-close>بستن</button></footer>
    </section>
</div>
