@model FollowUpSheetHead
<header class="fu-sheet__head">
    <span class="fu-num" aria-hidden="true">@FollowUpLabels.Fa(Model.Number)</span>
    <div class="fu-sheet__title"><h2>@Model.Title</h2>@if (Model.Subtitle is not null) { <p>@Model.Subtitle</p> }</div>
    @if (Model.Chip is not null) { <span class="fu-chip@(Model.ChipTone is { Length: > 0 } tone ? $" fu-chip--{tone}" : "")"><svg><use href="#i-case"/></svg><bdi>@Model.Chip</bdi></span> }
    @if (Model.CloseHref is not null || ViewData["FullPage"] is true) { <a class="icon-button fu-sheet__close" href="@(Model.CloseHref ?? "/follow-ups")" aria-label="بستن"><svg><use href="#i-close"/></svg></a> }
    else { <button type="button" class="icon-button fu-sheet__close" data-drawer-close aria-label="بستن"><svg><use href="#i-close"/></svg></button> }
    <span data-drawer-title hidden>@Model.Title</span>
</header>
