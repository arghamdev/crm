@model FollowUpDocumentsModel
@{
    var c = Model.Case;
    var stage = c.ActiveStage;
    var req = Model.Request;
    var dec = Model.Decide;
    var approval = Model.Approval;
    var basePath = $"/follow-ups/{c.Id}";
    var tab = Model.Tab is "request" or "decide" ? "request" : "documents";
    var passed = (dec.PassedItems ?? []).ToHashSet();
    var now = DateTimeOffset.UtcNow;
    var stageStatus = stage is null ? FollowUpLabels.Status(c.Status) : approval is { Decision: null } ? "در انتظار تأیید" : FollowUpLabels.Stage(stage.Status);
    var latest = c.Documents.GroupBy(x => x.Title).Select(g => g.OrderByDescending(x => x.Version).First()).OrderByDescending(x => x.UploadedAtUtc).ToList();
    var canDecide = approval is { CanDecide: true };
}
<div class="fu-sheet" data-fu-tabs>
    <partial name="_SheetHead" model="@(new FollowUpSheetHead(7, "مدارک و تأییدها", null, FollowUpSheetHead.CaseChip(c)))" />
    <div class="fu-sheet__body fu-sheet__body--tabs">
        <div class="fu-g">
            <label class="fu-f"><span class="fu-f__l">مرحله</span><span class="fu-f__c"><svg><use href="#i-layers"/></svg><input value="@(stage?.Name ?? "کل پرونده")" readonly aria-readonly="true" /></span></label>
            <div class="fu-f"><span class="fu-f__l">وضعیت</span><span class="fu-f__c"><span class="pill pill--@(approval is { Decision: null } ? "warning" : stage is null ? FollowUpLabels.StatusTone(c.Status) : FollowUpLabels.StageTone(stage.Status)) fu-pill-lg">@stageStatus</span></span></div>
        </div>
        <div class="fu-tabs-fill" role="tablist">
            <button type="button" role="tab" class="@(tab == "documents" ? "is-active" : "")" data-fu-tab="documents"><svg><use href="#i-folder"/></svg>مدارک <b>@FollowUpLabels.Fa(latest.Count)</b></button>
            <button type="button" role="tab" class="@(tab == "request" ? "is-active" : "")" data-fu-tab="request"><svg><use href="#i-shield"/></svg>@(canDecide ? "بررسی و تصمیم" : "درخواست تأیید")</button>
        </div>
    </div>

    <section data-fu-panel="documents" hidden="@(tab != "documents")">
        <div class="fu-sheet__body">
            @if (tab == "documents") { <div asp-validation-summary="ModelOnly" class="validation-summary"></div> }
            <h3 class="fu-sec__h"><svg><use href="#i-folder"/></svg>فهرست مدارک</h3>
            @if (latest.Count == 0) { <p class="empty-mini">مدرکی ثبت نشده است.</p> }
            else
            {
                <table class="fu-t">
                    <thead><tr><th>مدرک</th><th>نسخه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                    <tbody>
                        @foreach (var d in latest)
                        {
                            <tr>
                                <td><span class="fu-stage-name"><span class="fu-stage-ico"><svg><use href="#i-file"/></svg></span><span>@d.Title<small>@FollowUpLabels.Document(d.Kind)@(d.StageName is not null ? $" · {d.StageName}" : "") · @d.UploadedBy</small></span></span></td>
                                <td>@FollowUpLabels.Fa(d.Version)</td>
                                <td><span class="pill pill--sm pill--@FollowUpLabels.DocumentTone(d.Status)">@FollowUpLabels.DocumentStatus(d.Status)</span>@if (d.ReviewNote is not null) { <small class="cell-sub">@d.ReviewedBy: @d.ReviewNote</small> }</td>
                                <td><span class="fu-inline-actions"><a class="fu-add" href="@basePath/documents/@d.Id" target="_blank"><svg><use href="#i-eye"/></svg>مشاهده</a>@if (c.IsOpen && c.CanUpdate) { <button type="button" class="fu-add" data-new-version="@d.Title" data-new-version-kind="@d.Kind"><svg><use href="#i-plus"/></svg>افزودن نسخه</button> }</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (c.IsOpen && c.CanUpdate)
            {
                <details class="fu-more-fields" data-upload open="@(latest.Count == 0)">
                    <summary><svg><use href="#i-chevron"/></svg>افزودن مدرک یا نسخهٔ جدید</summary>
                    <form method="post" action="@basePath/documents" enctype="multipart/form-data" hx-post="@basePath/documents" hx-encoding="multipart/form-data" hx-target="#modalBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
                        @Html.AntiForgeryToken()
                        <div class="fu-g">
                            <label class="fu-f"><span class="fu-f__l">نوع مدرک</span><span class="fu-f__c"><svg><use href="#i-tag"/></svg><select name="kind">@foreach (var k in Enum.GetValues<FollowUpDocumentKind>()) { <option value="@k">@FollowUpLabels.Document(k)</option> }</select></span></label>
                            <label class="fu-f"><span class="fu-f__l">مرحله</span><span class="fu-f__c"><svg><use href="#i-layers"/></svg><select name="stageId"><option value="">— کل پرونده —</option>@foreach (var s in c.Stages) { <option value="@s.Id" selected="@(stage?.Id == s.Id)">@s.Name</option> }</select></span></label>
                            <label class="fu-f fu-span"><span class="fu-f__l">عنوان</span><span class="fu-f__c"><svg><use href="#i-note"/></svg><input name="title" maxlength="200" placeholder="همان عنوان قبلی = نسخهٔ جدید" list="fuDocTitles" /></span><datalist id="fuDocTitles">@foreach (var t in latest.Select(x => x.Title)) { <option value="@t"></option> }</datalist></label>
                            <label class="fu-dropzone fu-span"><svg><use href="#i-upload"/></svg><span>انتخاب فایل *</span><small data-file-out data-empty="حداکثر ۱۰ مگابایت">حداکثر ۱۰ مگابایت</small><input type="file" name="file" required data-file-names aria-label="فایل مدرک" /></label>
                            <label class="fu-checks-inline fu-span"><input type="checkbox" name="needsApproval" value="true" /><span>نیازمند تأیید است</span></label>
                        </div>
                        <div class="fu-inline-actions"><button class="button button--secondary" type="submit"><svg><use href="#i-upload"/></svg>بارگذاری</button></div>
                    </form>
                </details>
            }
        </div>
        <footer class="fu-sheet__foot"><button class="button button--ghost fu-foot__end" type="button" data-drawer-close>بستن</button></footer>
    </section>

    @if (canDecide && approval is not null)
    {
        <form data-fu-panel="request" hidden="@(tab != "request")" method="post" action="@basePath/approvals/@approval.Id" hx-post="@basePath/approvals/@approval.Id" hx-target="#modalBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
            <div class="fu-sheet__body">
                @Html.AntiForgeryToken()
                @if (tab == "request") { <div asp-validation-summary="ModelOnly" class="validation-summary"></div> }
                <h3 class="fu-sec__h"><svg><use href="#i-shield"/></svg>بررسی و تصمیم</h3>
                <div class="fu-g">
                    <label class="fu-f"><span class="fu-f__l">تأییدکننده</span><span class="fu-f__c"><svg><use href="#i-user"/></svg><input value="@approval.Approver" readonly aria-readonly="true" /></span></label>
                    <label class="fu-f"><span class="fu-f__l">سمت</span><span class="fu-f__c"><svg><use href="#i-org"/></svg><input value="@approval.ApproverRole" readonly aria-readonly="true" /></span></label>
                </div>
                <p class="fu-note fu-note--plain"><svg><use href="#i-info"/></svg><span>درخواست @approval.RequestedBy · @FollowUpLabels.When(approval.RequestedAtUtc, now) · @(approval.StageName ?? "کل پرونده")</span></p>
                <fieldset class="fu-checks-inline">
                    <legend>موارد بررسی (تیک = پذیرفته)</legend>
                    @foreach (var item in approval.ReviewItems) { <label><input type="checkbox" name="PassedItems" value="@item" checked="@passed.Contains(item)" /><span>@item</span></label> }
                </fieldset>
                <div class="fu-f">
                    <span class="fu-f__l">تصمیم<i>*</i></span>
                    <div class="fu-decide" role="radiogroup" aria-label="تصمیم">
                        <label><input type="radio" name="Decision" value="Approved" checked="@(dec.Decision == ApprovalDecision.Approved)" /><svg><use href="#i-check"/></svg>تأیید</label>
                        <label><input type="radio" name="Decision" value="NeedsCorrection" checked="@(dec.Decision == ApprovalDecision.NeedsCorrection)" /><svg><use href="#i-edit"/></svg>نیازمند اصلاح</label>
                        <label><input type="radio" name="Decision" value="Rejected" checked="@(dec.Decision == ApprovalDecision.Rejected)" /><svg><use href="#i-close"/></svg>رد</label>
                    </div>
                </div>
                <label class="fu-f"><span class="fu-f__l">توضیح تصمیم<i>*</i></span><span class="fu-f__c"><textarea name="Note" rows="3" required maxlength="1000">@dec.Note</textarea></span></label>
                <div class="fu-g">
                    <label class="fu-f"><span class="fu-f__l">مسئول اصلاح</span><span class="fu-f__c"><svg><use href="#i-user"/></svg><select name="CorrectionOwnerUserId">@foreach (var u in c.Users) { <option value="@u.Value" selected="@(dec.CorrectionOwnerUserId?.ToString() == u.Value)">@u.Label</option> }</select></span></label>
                    <div class="fu-f"><span class="fu-f__l">مهلت اصلاح</span><span class="fu-f__c--pair fu-f__c">
                        <span><svg><use href="#i-calendar"/></svg><input name="CorrectionDate" value="@dec.CorrectionDate" inputmode="numeric" data-jalali aria-label="تاریخ مهلت اصلاح" /></span>
                        <span><svg><use href="#i-clock"/></svg><input name="CorrectionTime" value="@dec.CorrectionTime" dir="ltr" inputmode="numeric" aria-label="ساعت مهلت اصلاح" /></span>
                    </span></div>
                </div>
                <p class="fu-note"><svg><use href="#i-info"/></svg><span>تصمیم همراه با نام تأییدکننده و زمان ثبت می‌شود. «نیازمند اصلاح» یا «رد» مرحله را برمی‌گرداند و پیشرفت را با دلیل کاهش می‌دهد.</span></p>
            </div>
            <footer class="fu-sheet__foot">
                <button class="button button--primary" type="submit"><svg><use href="#i-check"/></svg>ثبت تصمیم</button>
                <button class="button button--ghost fu-foot__end" type="button" data-drawer-close>انصراف</button>
            </footer>
        </form>
    }
    else
    {
        <form data-fu-panel="request" hidden="@(tab != "request")" method="post" action="@basePath/approvals" hx-post="@basePath/approvals" hx-target="#modalBody" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
            <div class="fu-sheet__body">
                @Html.AntiForgeryToken()
                @if (tab == "request") { <div asp-validation-summary="ModelOnly" class="validation-summary"></div> }
                @if (approval is { Decision: null }) { <p class="fu-note fu-note--amber"><svg><use href="#i-hourglass"/></svg><span>درخواست تأیید در انتظار تصمیم @approval.Approver است (از @FollowUpLabels.When(approval.RequestedAtUtc, now)).</span></p> }
                <h3 class="fu-sec__h"><svg><use href="#i-shield"/></svg>درخواست تأیید</h3>
                <div class="fu-g">
                    <label class="fu-f"><span class="fu-f__l">مرحله</span><span class="fu-f__c"><svg><use href="#i-layers"/></svg><select name="StageId"><option value="">— کل پرونده —</option>@foreach (var s in c.Stages.Where(x => x.Status is FollowUpStageStatus.Active or FollowUpStageStatus.Returned)) { <option value="@s.Id" selected="@(req.StageId == s.Id)">@s.Name</option> }</select></span></label>
                    <label class="fu-f"><span class="fu-f__l">تأییدکننده<i>*</i></span><span class="fu-f__c"><svg><use href="#i-user"/></svg><select name="ApproverUserId" required><option value="">— انتخاب —</option>@foreach (var u in c.Approvers) { <option value="@u.Value" selected="@(req.ApproverUserId.ToString() == u.Value)">@u.Label</option> }</select></span></label>
                    <label class="fu-f fu-span"><span class="fu-f__l">سمت تأییدکننده</span><span class="fu-f__c"><svg><use href="#i-org"/></svg><input name="ApproverRole" value="@req.ApproverRole" maxlength="60" /></span></label>
                </div>
                <fieldset class="fu-checks-inline">
                    <legend>موارد بررسی</legend>
                    @foreach (var item in req.ReviewItems ?? []) { <label><input type="checkbox" name="ReviewItems" value="@item" checked /><span>@item</span></label> }
                    @if ((req.ReviewItems ?? []).Count == 0) { <small class="fu-f__hint">موارد بررسی از چک‌لیست مرحله برداشته می‌شود.</small> }
                </fieldset>
                <p class="fu-note"><svg><use href="#i-info"/></svg><span>درخواست‌کننده نمی‌تواند درخواست خود را تأیید کند؛ مدارک ثبت‌شدهٔ مرحله «در انتظار تأیید» می‌شوند.</span></p>
            </div>
            <footer class="fu-sheet__foot">
                <button class="button button--primary" type="submit"><svg><use href="#i-shield"/></svg>ارسال درخواست تأیید</button>
                <button class="button button--ghost fu-foot__end" type="button" data-drawer-close>انصراف</button>
            </footer>
        </form>
    }
</div>
