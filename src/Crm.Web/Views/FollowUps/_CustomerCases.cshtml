@model FollowUpListDto
@{ var customerId = (Guid)ViewBag.CustomerId; }
<div class="fu-mini">
    <div class="fu-mini__head"><strong>پرونده‌های پیگیری باز</strong>@if (Model.CanCreate) { <a class="link-button" href="/follow-ups/new?customerId=@customerId"><svg><use href="#i-plus"/></svg>پرونده جدید</a> }</div>
    @if (Model.Items.Count == 0) { <p class="empty-mini">پروندهٔ باز پیگیری برای این حساب نیست.</p> }
    <ul>
        @foreach (var c in Model.Items)
        {
            var due = ListFormat.Due(c.NearestDueUtc, DateTimeOffset.UtcNow);
            <li>
                <a href="/follow-ups/@c.Id"><bdi>@c.Code</bdi> · @c.Subject</a>
                <small><span class="pill pill--sm pill--@FollowUpLabels.StatusTone(c.Status)">@FollowUpLabels.Status(c.Status)</span> @c.Progress٪ · @(c.NextAction ?? "بدون اقدام بعدی") · <span class="due due--@due.Item2">@due.Item1</span></small>
            </li>
        }
    </ul>
</div>
