@model FollowUpSupervisionDto
@{
    ViewData["Title"] = "نظارت مدیر بر پیگیری‌ها";
    var q = Model.Query;
    var now = Model.GeneratedAtUtc;
    var exportUrl = $"/follow-ups/supervision/export?branchId={Uri.EscapeDataString(q.BranchId ?? "")}&queueId={q.QueueId}&period={q.Period}";
    var maxWait = Model.LongestWaits.Select(x => x.AverageHours).DefaultIfEmpty(1).Max();
    var average = Model.LongestWaits.Count == 0 ? 0 : Model.LongestWaits.Sum(x => x.AverageHours * x.Count) / Math.Max(1, Model.LongestWaits.Sum(x => x.Count));
    var periodLabel = q.Period switch { "today" => "امروز", "month" => "۳۰ روز اخیر", "quarter" => "۹۰ روز اخیر", _ => "۷ روز اخیر" };
    // The status pill of each row reads like the image: «۲ ساعت تا مهلت»، «۳ ساعت تأخیر»، «بدون اقدام بعدی»، «در انتظار پذیرش».
    string Pill(FollowUpAttentionDto a)
    {
        if (a.Kind == "overdue" && a.DueUtc is { } due && due < now)
        {
            var late = now - due;
            return late.TotalHours >= 48 ? $"{FollowUpLabels.Fa((int)late.TotalDays)} روز تأخیر" : late.TotalMinutes >= 60 ? $"{FollowUpLabels.Fa((int)late.TotalHours)} ساعت تأخیر" : $"{FollowUpLabels.Fa(Math.Max(1, (int)late.TotalMinutes))} دقیقه تأخیر";
        }
        return a.Kind switch
        {
            "near" => FollowUpLabels.Fa(a.Reason.Split(" · ")[0]),
            "nonext" => "بدون اقدام بعدی",
            "unassigned" => "بدون مسئول",
            "referral" => a.Reason.StartsWith("در انتظار") ? "در انتظار پذیرش" : "ارجاع پذیرفته نشده",
            "rejected" => "ارجاع ردشده",
            "review" => "بازبینی انتظار گذشته",
            "stage" => "مرحلهٔ عقب‌افتاده",
            _ => "عقب‌افتاده"
        };
    }
    string Tone(FollowUpAttentionDto a) => a.Kind switch { "overdue" or "unassigned" => "danger", "nonext" or "near" or "review" or "stage" => "warning", "referral" or "rejected" => "violet", _ => a.Tone };
}
<nav class="breadcrumb"><a href="/follow-ups">مرکز پیگیری</a><svg><use href="#i-chevron"/></svg><span>نظارت مدیر</span></nav>
<div class="fu-page">
<section class="fu-sheet fu-sheet--card fu-super-sheet">
    <partial name="/Views/FollowUps/_SheetHead.cshtml" model="@(new FollowUpSheetHead(12, "نظارت مدیر") { Side = $"به‌روزرسانی: {FollowUpLabels.Fa(Crm.Domain.Common.TehranTime.Clock(now))}", SideIcon = "i-clock" })" />
    <div class="fu-sheet__body">
        <form class="fu-g fu-g--3 fu-card fu-super-filters2" method="get" action="/follow-ups/supervision" data-autosubmit>
            <label class="fu-f"><span class="fu-f__l"><svg class="fu-l-ico"><use href="#i-globe"/></svg>حوزه</span><span class="fu-f__c"><select name="branchId"><option value="">همهٔ شعب در دامنهٔ شما</option>@foreach (var b in Model.Branches) { <option value="@b.Value" selected="@(q.BranchId == b.Value)">@b.Label</option> }</select></span></label>
            <label class="fu-f"><span class="fu-f__l"><svg class="fu-l-ico"><use href="#i-users"/></svg>تیم</span><span class="fu-f__c"><select name="queueId"><option value="">همه</option>@foreach (var x in Model.Queues) { <option value="@x.Value" selected="@(q.QueueId?.ToString() == x.Value)">@x.Label</option> }</select></span></label>
            <label class="fu-f"><span class="fu-f__l"><svg class="fu-l-ico"><use href="#i-calendar"/></svg>بازه</span><span class="fu-f__c"><select name="period"><option value="today" selected="@(q.Period == "today")">امروز</option><option value="week" selected="@(q.Period is null or "week")">هفته جاری</option><option value="month" selected="@(q.Period == "month")">۳۰ روز اخیر</option><option value="quarter" selected="@(q.Period == "quarter")">۹۰ روز اخیر</option></select></span></label>
            <noscript><button class="button button--line" type="submit">اعمال</button></noscript>
        </form>
        @if (Model.SavedViews.Count > 0)
        {
            <div class="fu-views"><span class="fu-f__hint">نماهای ذخیره‌شده:</span>@foreach (var v in Model.SavedViews) { <a class="chip" href="/follow-ups/supervision?@v.Query.Replace("queue=", "queueId=").Replace("branch=", "branchId=")">@v.Name</a> }</div>
        }
        <div class="fu-tiles" aria-label="شمارنده‌ها">
            <a class="fu-tile" href="/follow-ups"><small>باز</small><strong>@FollowUpLabels.Fa(Model.OpenCount)</strong><svg><use href="#i-file"/></svg></a>
            <a class="fu-tile fu-tile--red" href="/follow-ups?view=overdue"><small>عقب‌افتاده</small><strong>@FollowUpLabels.Fa(Model.OverdueCount)</strong><svg><use href="#i-clock"/></svg></a>
            <a class="fu-tile fu-tile--amber" href="/follow-ups?view=nonext"><small>بدون اقدام بعدی</small><strong>@FollowUpLabels.Fa(Model.NoNextActionCount)</strong><svg><use href="#i-alert"/></svg></a>
            <a class="fu-tile fu-tile--purple" href="/follow-ups?view=referrals" title="@FollowUpLabels.Fa(Model.PendingReferrals) در انتظار · @FollowUpLabels.Fa(Model.RejectedReferrals) ردشده"><small>ارجاع نپذیرفته</small><strong>@FollowUpLabels.Fa(Model.PendingReferrals + Model.RejectedReferrals)</strong><svg><use href="#i-ban"/></svg></a>
        </div>
        <div class="fu-stack">
            <section class="fu-sec fu-card">
                <h2 class="fu-sec__h"><svg><use href="#i-file"/></svg>پرونده‌های نیازمند توجه</h2>
                <div class="table-wrap"><table class="fu-t fu-attention">
                    <thead><tr><th>پرونده / مشتری</th><th class="hide-sm">مسئول</th><th>وضعیت</th><th><span class="sr-only">بررسی</span></th></tr></thead>
                    <tbody>
                        @if (Model.Attention.Count == 0) { <tr><td colspan="4"><p class="empty-mini">پروندهٔ نیازمند توجهی نیست.</p></td></tr> }
                        @foreach (var a in Model.Attention)
                        {
                            <tr>
                                <td title="@a.Subject"><a class="cell-title" href="/follow-ups/@a.Id"><bdi>@a.Code</bdi></a><small class="cell-sub">@a.CustomerName</small></td>
                                <td class="hide-sm">@(a.Owner ?? "بدون مسئول")</td>
                                <td><span class="pill pill--sm pill--@Tone(a) fu-pill-ico" title="@a.Reason"><svg><use href="#@(a.Kind is "referral" ? "i-hourglass" : a.Kind is "nonext" or "unassigned" ? "i-alert" : "i-clock")"/></svg>@Pill(a)</span></td>
                                <td><a class="fu-add fu-add--line" href="/follow-ups/@a.Id">بررسی پرونده</a></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </section>
            <section class="fu-sec fu-card">
                <h2 class="fu-sec__h"><svg><use href="#i-clock"/></svg>بیشترین زمان انتظار<small class="fu-f__hint" title="میانگین در هر مرحله: @FollowUpLabels.Fa(average.ToString("0.#")) ساعت">میانگین در بازه انتخاب‌شده (@periodLabel)</small></h2>
                <ol class="fu-rank">
                    @foreach (var w in Model.LongestWaits)
                    {
                        var tone = w.AverageHours >= maxWait * .75 ? "is-red" : w.AverageHours >= maxWait * .4 ? "is-amber" : "is-blue";
                        <li class="@tone" title="@FollowUpLabels.Fa(w.Count) پرونده"><span>@w.Stage</span><b class="@tone">@FollowUpLabels.Fa(w.AverageHours.ToString("0.#")) ساعت</b></li>
                    }
                    @if (Model.LongestWaits.Count == 0) { <li class="empty-mini">داده‌ای نیست.</li> }
                </ol>
            </section>
        </div>
        @if (Model.NoNextActionCount > 0) { <p class="fu-note fu-note--amber fu-note--strong"><svg><use href="#i-alert"/></svg><span>@FollowUpLabels.Fa(Model.NoNextActionCount) پرونده نیازمند تعیین اقدام بعدی است.</span></p> }
        <details class="fu-more-fields">
            <summary><svg><use href="#i-chevron"/></svg>شاخص‌های دوره و بار کاری مسئولان</summary>
            <div class="fu-g">
                <dl class="fu-facts fu-span">
                    <div><dt>بسته‌شده</dt><dd>@FollowUpLabels.Fa(Model.ClosedInPeriod)</dd></div>
                    <div><dt>رعایت مهلت حل</dt><dd>@FollowUpLabels.Fa(Model.SlaMetPercent)٪</dd></div>
                    <div><dt>نرخ بازگشایی</dt><dd>@FollowUpLabels.Fa(Model.ReopenRatePercent)٪</dd></div>
                </dl>
                <ul class="fu-load-list fu-span">
                    @foreach (var l in Model.Load) { <li><span class="fu-person"><span class="fu-avatar">@ListFormat.Initial(l.Owner)</span>@l.Owner</span><span>@FollowUpLabels.Fa(l.Open) باز@(l.Capacity is { } cap ? $" از {FollowUpLabels.Fa(cap)}" : "")</span>@if (l.Overdue > 0) { <span class="pill pill--sm pill--danger">@FollowUpLabels.Fa(l.Overdue) عقب‌افتاده</span> }</li> }
                </ul>
            </div>
        </details>
    </div>
    <footer class="fu-sheet__foot">
        <form class="fu-save-view2" method="post" action="/follow-ups/supervision/views" data-prompt="نام نما (مثلاً شعبه مرکزی — هفتگی)" data-prompt-field="name">
            @Html.AntiForgeryToken()
            <input type="hidden" name="branchId" value="@q.BranchId" /><input type="hidden" name="queueId" value="@q.QueueId" /><input type="hidden" name="period" value="@q.Period" />
            <button class="button button--primary" type="submit"><svg><use href="#i-save"/></svg>ذخیره نما</button>
        </form>
        <a class="button button--plain fu-foot__end" href="@exportUrl"><svg><use href="#i-download"/></svg>خروجی گزارش</a>
    </footer>
</section>
</div>
