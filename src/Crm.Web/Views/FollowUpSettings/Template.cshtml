@model FollowUpTemplatePage
@{
    var t = Model.Template;
    var posted = Model.Posted;
    var isNew = t.Id == Guid.Empty;
    var draft = t.Status == FollowUpTemplateStatus.Draft;
    ViewData["Title"] = isNew ? "الگوی گردش کار جدید" : $"الگوی {t.Name}";
    var stages = (posted?.Stages ?? t.Stages).ToList();
    var name = posted?.Name ?? t.Name;
    var caseType = posted?.CaseType ?? t.CaseType;
    var action = isNew ? "/follow-ups/settings/templates" : $"/follow-ups/settings/templates/{t.Id}";
    var roles = new[] { "کارشناس فروش", "کارشناس فنی", "کارشناس انبار", "کارشناس تأمین", "کارشناس مالی", "کارشناس خدمات", "سرپرست فروش", "سرپرست خدمات", "مدیر فروش" };
    var rules = (posted?.Rules ?? t.Rules ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Split("=>", 2)).Where(x => x.Length == 2).ToList();
}
<nav class="breadcrumb"><a href="/follow-ups">مرکز پیگیری</a><svg><use href="#i-chevron"/></svg><a href="/follow-ups/settings">تنظیمات</a><svg><use href="#i-chevron"/></svg><span>طراحی الگوی گردش کار</span></nav>
<header class="list-head">
    <div class="list-head__title">
        <span class="list-head__icon"><svg><use href="#i-flow"/></svg></span>
        <div><h1>طراحی الگوی گردش کار</h1><p>@(isNew ? "پیش‌نویس نسخهٔ ۱" : draft ? $"پیش‌نویس نسخهٔ {t.Version} · نسخهٔ منتشرشدهٔ فعلی: {(t.CurrentPublishedVersion == 0 ? "ندارد" : t.CurrentPublishedVersion)}" : $"نسخهٔ {t.Version} · {FollowUpLabels.Template(t.Status)} — فقط‌خواندنی")</p></div>
    </div>
    @if (!draft && !isNew)
    {
        <form method="post" action="/follow-ups/settings/templates/@t.Id/version">@Html.AntiForgeryToken()<button class="button button--primary" type="submit"><svg><use href="#i-copy"/></svg>ساخت نسخهٔ @(t.Version + 1)</button></form>
    }
</header>
@if (Context.Request.Query.ContainsKey("published")) { <p class="account-banner"><svg><use href="#i-check"/></svg>نسخهٔ @t.Version منتشر شد؛ پرونده‌های جدید از این نسخه استفاده می‌کنند و پرونده‌های باز روی نسخهٔ خود می‌مانند.</p> }
@if (Context.Request.Query.ContainsKey("saved")) { <p class="account-banner"><svg><use href="#i-check"/></svg>پیش‌نویس ذخیره شد.</p> }
<form class="fu-form" method="post" action="@action" data-weights>
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExpectedVersion" value="@t.EntityVersion" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <fieldset class="fu-form__grid" disabled="@(!draft)">
        <section class="form-section">
            <h3>مشخصات الگو</h3>
            <div class="form-grid">
                <label class="field--full"><span>نام الگو *</span><input name="Name" value="@name" required maxlength="160" /></label>
                <label><span>نوع پیگیری *</span><select name="CaseType">@foreach (var x in FollowUpCaseTypes.All) { <option value="@x.Key" selected="@(caseType == x.Key)">@x.Label</option> }</select></label>
                <label><span>دامنه</span><select name="Scope"><option value="Company">کل شرکت</option>@foreach (var b in t.Branches) { <option value="@b.Value" selected="@((posted?.Scope ?? t.Scope) == b.Value)">@b.Label</option> }</select></label>
                <label><span>واحد مالک *</span><input name="OwnerUnit" value="@(posted?.OwnerUnit ?? t.OwnerUnit)" required maxlength="120" /></label>
                <label><span>نسخهٔ فعلی</span><input value="@(t.CurrentPublishedVersion == 0 ? "—" : $"نسخه {t.CurrentPublishedVersion}")" disabled /></label>
                <label><span>سیاست مهلت</span><select name="SlaPolicyId"><option value="">— براساس اولویت —</option>@foreach (var p in t.Policies) { <option value="@p.Value" selected="@((posted?.SlaPolicyId ?? t.SlaPolicyId)?.ToString() == p.Value)">@p.Label</option> }</select></label>
                <label><span>اولویت پیش‌فرض</span><select name="DefaultPriority">@foreach (var p in Enum.GetValues<FollowUpPriority>()) { <option value="@p" selected="@((posted?.DefaultPriority ?? t.DefaultPriority) == p)">@FollowUpLabels.Priority(p)</option> }</select></label>
                <label class="field--full"><span>شرح</span><textarea name="Description" rows="2" maxlength="1000">@(posted?.Description ?? t.Description)</textarea></label>
            </div>
        </section>
        <section class="form-section">
            <h3>قواعد (اگر … آنگاه …)</h3>
            <div class="fu-rule-editor" data-rows>
                @for (var i = 0; i < Math.Max(1, rules.Count); i++)
                {
                    var rule = i < rules.Count ? rules[i] : ["", ""];
                    <div class="fu-rule-editor__row" data-row><span>اگر</span><input name="RuleCondition" value="@rule[0].Trim()" maxlength="200" placeholder="موجودی ناکافی بود" aria-label="شرط" /><span>آنگاه</span><input name="RuleAction" value="@rule[1].Trim()" maxlength="200" placeholder="ایجاد وظیفه تأمین موجودی" aria-label="اقدام" /><button type="button" class="icon-button" data-remove-row aria-label="حذف قاعده"><svg><use href="#i-close"/></svg></button></div>
                }
                <template data-row-template><div class="fu-rule-editor__row" data-row><span>اگر</span><input name="RuleCondition" maxlength="200" aria-label="شرط" /><span>آنگاه</span><input name="RuleAction" maxlength="200" aria-label="اقدام" /><button type="button" class="icon-button" data-remove-row aria-label="حذف قاعده"><svg><use href="#i-close"/></svg></button></div></template>
                <button type="button" class="link-button" data-add-row><svg><use href="#i-plus"/></svg>افزودن قاعده</button>
                <small class="field-help">اقدام‌های قابل اجرا: «ایجاد وظیفه …»، «کنار گذاشتن مرحله …»، «شروع مرحله …»، «افزایش اولویت».</small>
            </div>
        </section>
        <section class="form-section fu-form__wide">
            <h3>مراحل و وزن‌ها</h3>
            <div class="fu-stage-editor" data-rows>
                <div class="fu-stage-editor__head"><span></span><span>مرحله</span><span>وزن ٪</span><span>نقش مسئول</span><span>الزامی</span><span>هم‌زمان با قبلی</span><span>مهلت (ساعت)</span><span></span></div>
                @for (var i = 0; i < stages.Count; i++)
                {
                    var s = stages[i];
                    <div class="fu-stage-editor__row" data-row>
                        <span class="fu-drag" title="جابه‌جایی"><button type="button" class="icon-button" data-move="up" aria-label="بالا">▲</button><button type="button" class="icon-button" data-move="down" aria-label="پایین">▼</button></span>
                        <input name="Stages[@i].Name" value="@s.Name" maxlength="120" aria-label="نام مرحله" />
                        <input name="Stages[@i].Weight" value="@s.Weight" type="number" min="0" max="100" dir="ltr" aria-label="وزن" data-weight />
                        <select name="Stages[@i].ResponsibleRole" aria-label="نقش مسئول">@foreach (var r in roles.Append(s.ResponsibleRole ?? "").Where(x => x.Length > 0).Distinct()) { <option value="@r" selected="@(s.ResponsibleRole == r)">@r</option> }</select>
                        <label class="fu-toggle"><input type="checkbox" name="Stages[@i].Required" value="true" checked="@s.Required" /><span class="sr-only">الزامی</span></label>
                        <label class="fu-toggle"><input type="checkbox" name="Stages[@i].ParallelWithPrevious" value="true" checked="@s.ParallelWithPrevious" /><span class="sr-only">هم‌زمان</span></label>
                        <input name="Stages[@i].DurationHours" value="@s.DurationHours" type="number" min="1" max="2000" dir="ltr" aria-label="مهلت مرحله" placeholder="سیاست" />
                        <button type="button" class="icon-button" data-remove-row aria-label="حذف مرحله"><svg><use href="#i-close"/></svg></button>
                        <textarea name="Stages[@i].Checklist" rows="2" maxlength="2000" class="fu-stage-editor__checklist" placeholder="چک‌لیست مرحله؛ هر مورد در یک خط" aria-label="چک‌لیست">@s.Checklist</textarea>
                        <input name="Stages[@i].Condition" value="@s.Condition" maxlength="200" class="fu-stage-editor__condition" placeholder="شرط اجرای مرحله (اختیاری)" aria-label="شرط" />
                    </div>
                }
                <template data-row-template>
                    <div class="fu-stage-editor__row" data-row>
                        <span class="fu-drag"><button type="button" class="icon-button" data-move="up" aria-label="بالا">▲</button><button type="button" class="icon-button" data-move="down" aria-label="پایین">▼</button></span>
                        <input name="Stages[__i__].Name" maxlength="120" aria-label="نام مرحله" />
                        <input name="Stages[__i__].Weight" value="0" type="number" min="0" max="100" dir="ltr" aria-label="وزن" data-weight />
                        <select name="Stages[__i__].ResponsibleRole" aria-label="نقش مسئول">@foreach (var r in roles) { <option value="@r">@r</option> }</select>
                        <label class="fu-toggle"><input type="checkbox" name="Stages[__i__].Required" value="true" checked /><span class="sr-only">الزامی</span></label>
                        <label class="fu-toggle"><input type="checkbox" name="Stages[__i__].ParallelWithPrevious" value="true" /><span class="sr-only">هم‌زمان</span></label>
                        <input name="Stages[__i__].DurationHours" type="number" min="1" max="2000" dir="ltr" aria-label="مهلت مرحله" placeholder="سیاست" />
                        <button type="button" class="icon-button" data-remove-row aria-label="حذف مرحله"><svg><use href="#i-close"/></svg></button>
                        <textarea name="Stages[__i__].Checklist" rows="2" maxlength="2000" class="fu-stage-editor__checklist" placeholder="چک‌لیست مرحله؛ هر مورد در یک خط" aria-label="چک‌لیست"></textarea>
                        <input name="Stages[__i__].Condition" maxlength="200" class="fu-stage-editor__condition" placeholder="شرط اجرای مرحله (اختیاری)" aria-label="شرط" />
                    </div>
                </template>
                <div class="fu-stage-editor__foot">
                    <button type="button" class="link-button" data-add-row><svg><use href="#i-plus"/></svg>افزودن مرحله</button>
                    <span class="fu-weight-sum" data-weight-sum>مجموع وزن‌ها: <b>@stages.Sum(x => x.Weight)</b>٪ <em>باید ۱۰۰٪ باشد</em></span>
                </div>
            </div>
        </section>
        <section class="form-section fu-form__wide">
            <h3>شرایط بستن</h3>
            <div class="form-grid">
                <label class="consent-row"><input type="checkbox" name="RequireAllRequiredStages" value="true" checked="@(posted?.RequireAllRequiredStages ?? t.RequireAllRequiredStages)" /><span>تکمیل همهٔ مراحل الزامی</span></label>
                <label class="consent-row"><input type="checkbox" name="RequireCustomerApproval" value="true" checked="@(posted?.RequireCustomerApproval ?? t.RequireCustomerApproval)" /><span>دریافت تأیید مشتری</span></label>
                <label class="field--full"><span>معیار پایان</span><input name="ClosingCriteria" value="@(posted?.ClosingCriteria ?? t.ClosingCriteria)" maxlength="500" /></label>
            </div>
        </section>
    </fieldset>
    <p class="fu-sla-note"><svg><use href="#i-info"/></svg><span>نسخهٔ جدید فقط برای پرونده‌های جدید اعمال می‌شود؛ پرونده‌های باز با نسخهٔ شروع خود ادامه می‌دهند.</span></p>
    @if (draft)
    {
        <div class="fu-form__actions">
            <a class="button button--ghost" href="/follow-ups/settings">انصراف</a>
            <button class="button button--ghost" type="submit"><svg><use href="#i-edit"/></svg>ذخیرهٔ پیش‌نویس</button>
            @if (!isNew) { <button class="button button--primary" type="submit" name="publish" value="true" data-publish><svg><use href="#i-check"/></svg>انتشار نسخهٔ @t.Version</button> }
        </div>
    }
</form>
