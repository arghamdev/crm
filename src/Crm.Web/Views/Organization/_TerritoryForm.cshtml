@model TerritoryFormDto
@{ var isEdit = Model.Id is not null; string LocalDate(DateTimeOffset value) => value.ToString("yyyy-MM-ddTHH:mm"); }
<form class="drawer-form" method="post" action="/organization/territories/save" hx-post="/organization/territories/save" hx-target="#drawerBody" hx-swap="innerHTML">
    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="form-section"><h3>@(isEdit ? "ویرایش قلمرو" : "قلمرو جدید")</h3><div class="form-grid"><label class="field"><span>شناسه پایدار *</span><input name="TerritoryId" value="@Model.TerritoryId" readonly="@isEdit"/><span asp-validation-for="TerritoryId" class="field-error"></span></label><label class="field"><span>کد *</span><input name="Code" value="@Model.Code"/><span asp-validation-for="Code" class="field-error"></span></label><label class="field field--full"><span>نام *</span><input name="Name" value="@Model.Name"/><span asp-validation-for="Name" class="field-error"></span></label><label class="field"><span>بُعد قلمرو *</span><select name="Dimension" disabled="@isEdit"><option value="Geography" selected="@(Model.Dimension == Crm.Domain.Organization.TerritoryDimension.Geography)">جغرافیا</option><option value="Product" selected="@(Model.Dimension == Crm.Domain.Organization.TerritoryDimension.Product)">محصول</option><option value="Industry" selected="@(Model.Dimension == Crm.Domain.Organization.TerritoryDimension.Industry)">صنعت</option><option value="Channel" selected="@(Model.Dimension == Crm.Domain.Organization.TerritoryDimension.Channel)">کانال</option></select>@if (isEdit) { <input type="hidden" name="Dimension" value="@Model.Dimension"/> }</label><label class="field"><span>شروع اعتبار *</span><input type="datetime-local" name="ValidFromUtc" value="@LocalDate(Model.ValidFromUtc)"/></label><label class="field field--full"><span>پایان اعتبار</span><input type="datetime-local" name="ValidToUtc" value="@(Model.ValidToUtc is null ? "" : LocalDate(Model.ValidToUtc.Value))"/><span asp-validation-for="ValidToUtc" class="field-error"></span></label></div></section>
    <div class="identity-form-note">پایان اعتبار اختیاری است؛ وضعیت «مؤثر» هم‌زمان از وضعیت رکورد و بازه زمانی محاسبه می‌شود.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">@(isEdit ? "ذخیره تغییرات" : "ایجاد قلمرو")</button></div>
</form>
