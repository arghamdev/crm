@model OrganizationAdminDto
@functions {
    private static string UnitType(Crm.Domain.Organization.OrganizationUnitType value) => value switch { Crm.Domain.Organization.OrganizationUnitType.Headquarters => "ستاد", Crm.Domain.Organization.OrganizationUnitType.Region => "منطقه", Crm.Domain.Organization.OrganizationUnitType.Branch => "شعبه", _ => "تیم فروش" };
    private static string Dimension(Crm.Domain.Organization.TerritoryDimension value) => value switch { Crm.Domain.Organization.TerritoryDimension.Geography => "جغرافیا", Crm.Domain.Organization.TerritoryDimension.Product => "محصول", Crm.Domain.Organization.TerritoryDimension.Industry => "صنعت", _ => "کانال" };
}
<section class="organization-summary-grid">
    <article class="panel organization-company-card"><div class="panel-heading"><div><strong>شرکت جاری</strong><small>شناسه پایدار: @Model.Company.CompanyId</small></div><a class="link-button" href="/organization/company/edit" hx-get="/organization/company/edit" hx-target="#drawerBody">ویرایش</a></div><h2>@Model.Company.Name</h2><div class="organization-meta"><span>کد <b>@Model.Company.Code</b></span><span>منطقه زمانی <b>@Model.Company.TimeZoneId</b></span><span>نسخه <b>@Model.Company.Version</b></span></div></article>
    <article class="panel metric-card"><span>واحدهای فعال</span><strong>@Model.Units.Count(x => x.Status == Crm.Domain.Organization.OrganizationStatus.Active)</strong><small>@Model.Units.Count واحد ثبت‌شده</small></article>
    <article class="panel metric-card"><span>قلمروهای مؤثر</span><strong>@Model.Territories.Count(x => x.IsEffective)</strong><small>@Model.Territories.Count قلمرو ثبت‌شده</small></article>
</section>
<section class="panel table-panel organization-section"><div class="panel-heading"><div><strong>سلسله‌مراتب سازمانی</strong><small>ستاد ← منطقه ← شعبه ← تیم فروش</small></div><div class="table-actions"><a class="link-button" href="/organization/units/create?type=Region" hx-get="/organization/units/create?type=Region" hx-target="#drawerBody">منطقه جدید</a><a class="link-button" href="/organization/units/create?type=Branch" hx-get="/organization/units/create?type=Branch" hx-target="#drawerBody">شعبه جدید</a></div></div><div class="table-wrap"><table><thead><tr><th>واحد</th><th>نوع</th><th>والد</th><th>وضعیت</th><th>نسخه</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Units)
{
    <tr><td><span class="entity-cell"><span class="entity-avatar">@item.Name[..1]</span><span><strong>@item.Name</strong><small>@item.UnitId · @item.Code</small></span></span></td><td>@UnitType(item.Type)</td><td>@(item.ParentName ?? "—")</td><td><span class="badge @(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "badge--success" : "badge--danger")"><span></span>@(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "فعال" : "غیرفعال")</span></td><td>@item.Version</td><td><div class="row-actions"><a class="link-button" href="/organization/units/@item.Id/edit" hx-get="/organization/units/@item.Id/edit" hx-target="#drawerBody">ویرایش</a><form method="post" action="/organization/units/@item.Id/status" hx-post="/organization/units/@item.Id/status" hx-target="closest td" hx-swap="innerHTML" data-confirm="وضعیت این واحد تغییر کند؟">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@item.Version"/><input type="hidden" name="status" value="@(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "Inactive" : "Active")"/><button class="link-button link-button--danger" type="submit">@(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "غیرفعال" : "فعال")</button></form></div></td></tr>
}
</tbody></table></div></section>
<section class="panel table-panel organization-section"><div class="panel-heading"><div><strong>قلمروهای فروش</strong><small>اعتبار زمانی مستقل از وضعیت فعال/غیرفعال کنترل می‌شود</small></div><a class="link-button" href="/organization/territories/create" hx-get="/organization/territories/create" hx-target="#drawerBody">قلمرو جدید</a></div><div class="table-wrap"><table><thead><tr><th>قلمرو</th><th>بُعد</th><th>اعتبار از</th><th>اعتبار تا</th><th>وضعیت</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Territories)
{
    <tr><td><strong>@item.Name</strong><small class="table-subline">@item.TerritoryId · @item.Code</small></td><td>@Dimension(item.Dimension)</td><td>@item.ValidFromUtc.ToString("yyyy/MM/dd")</td><td>@(item.ValidToUtc?.ToString("yyyy/MM/dd") ?? "بدون پایان")</td><td><span class="badge @(item.IsEffective ? "badge--success" : "badge--warning")"><span></span>@(item.IsEffective ? "مؤثر" : item.Status == Crm.Domain.Organization.OrganizationStatus.Inactive ? "غیرفعال" : "خارج از بازه")</span></td><td><div class="row-actions"><a class="link-button" href="/organization/territories/@item.Id/edit" hx-get="/organization/territories/@item.Id/edit" hx-target="#drawerBody">ویرایش</a><form method="post" action="/organization/territories/@item.Id/status" hx-post="/organization/territories/@item.Id/status" hx-target="closest td" hx-swap="innerHTML" data-confirm="وضعیت این قلمرو تغییر کند؟">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@item.Version"/><input type="hidden" name="status" value="@(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "Inactive" : "Active")"/><button class="link-button link-button--danger" type="submit">@(item.Status == Crm.Domain.Organization.OrganizationStatus.Active ? "غیرفعال" : "فعال")</button></form></div></td></tr>
}
</tbody></table></div></section>
<section class="panel table-panel organization-section"><div class="panel-heading"><div><strong>تاریخچه تغییرات</strong><small>۴۰ رویداد اخیر این شرکت</small></div></div><div class="table-wrap"><table><thead><tr><th>زمان</th><th>موجودیت</th><th>عملیات</th><th>شرح</th><th>Correlation ID</th></tr></thead><tbody>
@if (Model.Changes.Count == 0) { <tr><td colspan="5" class="empty-cell">هنوز تغییری ثبت نشده است.</td></tr> }
@foreach (var item in Model.Changes)
{
    <tr><td>@item.OccurredAtUtc.ToString("yyyy/MM/dd HH:mm")</td><td>@item.EntityType <small class="table-subline">@item.EntityBusinessId</small></td><td>@item.Action</td><td>@item.Summary</td><td><code>@item.CorrelationId</code></td></tr>
}
</tbody></table></div></section>

