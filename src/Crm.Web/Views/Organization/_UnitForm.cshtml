@model OrganizationUnitFormDto
@{ var isEdit = Model.Id is not null; }
<form class="drawer-form" method="post" action="/organization/units/save" hx-post="/organization/units/save" hx-target="#drawerBody" hx-swap="innerHTML">
    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion"/><input type="hidden" name="Type" value="@Model.Type"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="form-section"><h3>@(isEdit ? "ویرایش واحد سازمانی" : "واحد سازمانی جدید")</h3><div class="form-grid"><label class="field"><span>شناسه پایدار *</span><input name="UnitId" value="@Model.UnitId" readonly="@isEdit"/><span asp-validation-for="UnitId" class="field-error"></span></label><label class="field"><span>کد *</span><input name="Code" value="@Model.Code"/><span asp-validation-for="Code" class="field-error"></span></label><label class="field field--full"><span>نام *</span><input name="Name" value="@Model.Name"/><span asp-validation-for="Name" class="field-error"></span></label><label class="field field--full"><span>واحد والد</span><select name="ParentUnitId"><option value="">بدون والد</option>@foreach (var parent in Model.ParentOptions) { <option value="@parent.Id" selected="@(parent.Id == Model.ParentUnitId)">@parent.Name — @parent.Type</option> }</select></label></div></section>
    <div class="identity-form-note">نوع واحد: <b>@Model.Type</b>. نوع و شناسه پایدار پس از ایجاد تغییر نمی‌کنند و چرخه در ساختار رد می‌شود.</div><div class="drawer-actions"><button class="button button--ghost" type="button" data-drawer-close>انصراف</button><button class="button button--primary" type="submit">@(isEdit ? "ذخیره تغییرات" : "ایجاد واحد")</button></div>
</form>

