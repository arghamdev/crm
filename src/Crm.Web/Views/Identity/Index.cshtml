@model IReadOnlyList<UserDto>
@{ ViewData["Title"] = "کاربران و دسترسی"; var query = Context.Request.Query["q"].ToString(); }
<header class="page-header"><div><span class="eyebrow">مدیریت هویت و دسترسی</span><h1>کاربران و دسترسی</h1><p>نشست، هویت خارجی، RBAC و دامنه داده در مدل اولویت ۲</p></div><div class="page-actions"><a class="button button--primary" href="/identity/users/create" hx-get="/identity/users/create" hx-target="#drawerBody"><svg><use href="#i-plus"/></svg> کاربر جدید</a></div></header>
<section class="identity-banner"><span><svg><use href="#i-shield"/></svg></span><div><strong>کنترل نشست و SecurityVersion فعال است</strong><p>کوکی فقط شناسه‌های حداقلی دارد؛ نقش و Scope در هر درخواست از Snapshot سمت سرور خوانده می‌شود.</p></div><b>OIDC-ready</b></section>
<section class="panel table-panel"><form class="toolbar identity-filters" method="get" action="/identity/users" hx-get="/identity/users/table" hx-target="#userTable" hx-trigger="input changed delay:300ms, change"><label class="table-search"><svg><use href="#i-search"/></svg><input name="q" value="@query" placeholder="نام، ایمیل یا نام کاربری..."/></label><select name="status"><option value="">همه وضعیت‌ها</option><option value="PendingActivation">در انتظار اتصال</option><option value="Active">فعال</option><option value="Suspended">تعلیق</option><option value="Disabled">غیرفعال</option></select><select name="scope"><option value="">همه دامنه‌ها</option><option value="مرکزی">شعبه مرکزی</option><option value="اصفهان">شعبه اصفهان</option><option value="جنوب">شعبه جنوب</option><option value="شرکت">شرکت</option></select></form><div id="userTable" hx-get="/identity/users/table" hx-trigger="userChanged from:body"><partial name="_Table" model="Model" /></div></section>
