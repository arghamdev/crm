@model UserDetailsDto
@{ ViewData["Title"] = "مدیریت کاربر"; var user = Model.User; var organization = ViewBag.Organization as OrganizationContextDto; var organizationBranches = organization?.Branches ?? Array.Empty<OrganizationUnitOptionDto>(); var organizationTerritories = organization?.Territories ?? Array.Empty<TerritoryOptionDto>(); }
<nav class="breadcrumb"><a href="/identity/users">کاربران</a><svg><use href="#i-chevron"/></svg><span>@user.UserName</span></nav>
<header class="page-header"><div><span class="eyebrow">پروفایل دسترسی</span><h1>@user.DisplayName</h1><p>@user.Email.ToLowerInvariant() · SecurityVersion @user.SecurityVersion</p></div><a class="button button--ghost" href="/identity/users">بازگشت</a></header>
@if (TempData["IdentityMessage"] is string message) { <section class="demo-alert"><strong>انجام شد</strong><span>@message</span></section> }
@if (TempData["IdentityError"] is string error) { <div class="validation-summary">@error</div> }
<section class="customer-kpis"><article><small>وضعیت</small><strong>@user.Status</strong><span>@(user.HasExternalIdentity ? "هویت متصل" : "بدون هویت خارجی")</span></article><article><small>نشست فعال</small><strong>@user.ActiveSessionCount</strong><span>حداکثر ۳ نشست</span></article><article><small>نقش مؤثر</small><strong>@(user.Roles.Count == 0 ? "بدون نقش" : string.Join("، ", user.Roles))</strong><span>Snapshot سمت سرور</span></article><article><small>آخرین ورود</small><strong>@(user.LastLoginAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</strong><span>UTC persisted</span></article></section>
<section class="panel identity-detail-section"><div class="panel-heading"><div><strong>چرخه‌عمر حساب</strong><small>تغییر وضعیت نشست‌های قبلی را باطل می‌کند.</small></div></div><div class="identity-actions">
    @if ((user.Status is UserStatus.Suspended or UserStatus.PendingActivation) && user.HasExternalIdentity) { <form method="post" action="/identity/users/@user.Id/status">@Html.AntiForgeryToken()<input type="hidden" name="expectedSecurityVersion" value="@user.SecurityVersion"/><input type="hidden" name="status" value="Active"/><button class="button button--soft-green" type="submit">فعال‌سازی</button></form> }
    @if (user.Status == UserStatus.Active) { <form method="post" action="/identity/users/@user.Id/status" data-confirm="کاربر تعلیق و همه نشست‌های او باطل شوند؟">@Html.AntiForgeryToken()<input type="hidden" name="expectedSecurityVersion" value="@user.SecurityVersion"/><input type="hidden" name="status" value="Suspended"/><button class="button button--soft-danger" type="submit">تعلیق و ابطال نشست‌ها</button></form> }
    @if (user.Status is not UserStatus.Disabled and not UserStatus.Archived) { <form method="post" action="/identity/users/@user.Id/status" data-confirm="حساب کاربر غیرفعال شود؟ این عملیات بازگشت مستقیم ندارد.">@Html.AntiForgeryToken()<input type="hidden" name="expectedSecurityVersion" value="@user.SecurityVersion"/><input type="hidden" name="status" value="Disabled"/><button class="button button--danger" type="submit">غیرفعال‌سازی</button></form> }
</div></section>
<section class="panel identity-detail-section"><div class="panel-heading"><div><strong>نقش‌ها و دامنه‌ها</strong><small>Scope روی تمام Queryها و Mutationهای ماژول‌های نمونه اعمال می‌شود.</small></div></div><form class="inline-admin-form" method="post" action="/identity/users/@user.Id/roles">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedSecurityVersion" value="@user.SecurityVersion"/><select name="RoleKey">@foreach (var assignable in (ViewBag.AssignableRoles as IReadOnlyList<AssignableRoleDto>) ?? []) { <option value="@assignable.RoleKey">@assignable.Label — @string.Join("/", assignable.ScopeTypes)</option> }</select><select name="ScopeType"><option value="Branch">شعبه</option><option value="Territory">قلمرو</option><option value="Company">شرکت</option></select><select name="ScopeId">@if(organization?.SelectedCompanyId is not null){<option value="@organization.SelectedCompanyId">شرکت جاری — @organization.SelectedCompanyCode</option>}@foreach(var branch in organizationBranches){<option value="@branch.Id">@branch.Code — @branch.Name</option>}@foreach(var territory in organizationTerritories){<option value="@territory.Id">@territory.Code — @territory.Name</option>}</select><input name="Reason" value="تخصیص مدیریتی" required/><button class="button button--primary" type="submit">تخصیص</button></form>
<div class="table-wrap"><table><thead><tr><th>نقش</th><th>شرکت</th><th>دامنه</th><th>شروع</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var role in Model.RoleAssignments){<tr><td>@role.RoleLabel <small>(@role.RoleKey)</small></td><td><code>@role.CompanyId</code></td><td>@role.ScopeLabel <code>@role.ScopeType:@role.ScopeId</code></td><td>@role.ValidFromUtc.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@role.Status</td><td>@if(role.Status == RoleAssignmentStatus.Active){<form method="post" action="/identity/users/@user.Id/roles/@role.Id/revoke" data-confirm="این تخصیص نقش لغو و نشست‌های کاربر باطل شوند؟">@Html.AntiForgeryToken()<input type="hidden" name="expectedSecurityVersion" value="@user.SecurityVersion"/><button class="button button--ghost button--xs" type="submit">لغو</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel identity-detail-section"><div class="panel-heading"><div><strong>نشست‌ها</strong><small>انقضای بیکار ۳۰ دقیقه و انقضای مطلق ۸ ساعت</small></div></div><div class="table-wrap"><table><thead><tr><th>ایجاد</th><th>آخرین فعالیت</th><th>Context</th><th>انقضای مطلق</th><th>عامل کاربر</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var session in Model.Sessions){<tr><td>@session.IssuedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td><td>@session.LastSeenAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td><td><code>@(session.SelectedCompanyId ?? "—")/@(session.SelectedBranchId ?? "*")/@(session.SelectedTerritoryId ?? "*")</code></td><td>@session.AbsoluteExpiresAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td><td title="@session.UserAgentSummary">@(session.UserAgentSummary.Length > 32 ? session.UserAgentSummary[..32] + "…" : session.UserAgentSummary)</td><td>@(session.RevokedAtUtc is null ? "فعال/منقضی‌نشده" : "باطل‌شده")</td><td>@if(session.RevokedAtUtc is null){<form method="post" action="/identity/users/@user.Id/sessions/@session.Id/revoke" data-confirm="این نشست باطل شود؟">@Html.AntiForgeryToken()<button class="button button--ghost button--xs" type="submit">ابطال</button></form>}</td></tr>}</tbody></table></div></section>
<section class="customer-overview-grid"><article class="panel"><div class="panel-heading"><div><strong>هویت‌های خارجی</strong><small>کلید یکتا: Issuer + Subject</small></div></div><div class="audit-list">@foreach(var item in Model.ExternalIdentities){<div><strong>@item.ProviderKey</strong><span>@item.Issuer</span><code>@item.Subject</code></div>}</div></article><article class="panel"><div class="panel-heading"><div><strong>ممیزی امنیتی</strong><small>۳۰ رخداد آخر</small></div></div><div class="audit-list">@foreach(var item in Model.AuditEvents){<div><strong>@item.EventType · @item.Outcome</strong><span>@item.OccurredAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span><small>@item.Reason</small></div>}</div></article></section>
