{
  "Authentication": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "https://replace-with-test-idp",
      "ClientId": "replace-from-secret-store",
      "ClientSecret": "replace-from-secret-store",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc"
    }
  },
  "DataProtection": {
    "KeyRingPath": "/replace-with-protected-shared-keyring",
    "RequireSharedKeyRing": true
  },
  "Security": {
    "IpHashSalt": "replace-from-secret-store"
  },
  "ReverseProxy": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": ["10.0.0.10"]
  }
}
